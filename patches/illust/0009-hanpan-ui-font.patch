+/// Hanpan: `family`'s Regular entry (its first entry when none says Regular) and its Bold one, each
+/// with the names the list gives it, so the face is found in a collection by name. A Bold in the
+/// Regular's file (a collection) is not read twice.
+async fn load_ui(family: &str) -> Result<PcFaceFiles, String> {
+    let faces = FACES.with(|f| f.borrow().get(family).cloned()).unwrap_or_default();
+    let text = |face: &JsValue, key: &str| Reflect::get(face, &JsValue::from_str(key)).ok().and_then(|s| s.as_string()).unwrap_or_default();
