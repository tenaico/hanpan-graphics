+/// Hanpan: the Hanpan colour scheme and the `hanpan.theme` / `hanpan.status` page API methods.
+#[cfg(test)]
+mod hanpan_theme_tests {
+    use super::*;
+    use crate::theme::{Brightness, Scheme, Tokens};
+    use serde_json::{Value, json};
+
+    type Look = (bool, egui::Color32, egui::Color32, egui::Color32, egui::Color32, egui::Color32, egui::Color32);
+
+    fn app(embedded: bool) -> crate::VectorcraftApp {
+        crate::VectorcraftApp::new(vectorcraft_engine::Session::new(), crate::Services { embedded, ..Default::default() })
+    }
+
+    fn call(app: &mut crate::VectorcraftApp, ctx: &egui::Context, method: &str, params: Value) -> Value {
+        let (req, _rx) = crate::control::ControlRequest::new(method, params);
+        match crate::control::handle(app, ctx, &req) {
+            crate::control::Outcome::Done(v) => v,
+            _ => panic!("{method}: expected an immediate reply"),
+        }
+    }
+
+    /// The colours that tell the schemes apart.
+    fn look(t: &Tokens) -> Look {
+        (t.dark, t.app_bar, t.panel, t.pasteboard, t.text, t.accent, t.accent_strong)
+    }
+
+    fn hanpan(dark: bool) -> Look {
+        look(&Tokens::hanpan(dark))
+    }
+
+    /// Preferences that ask for Classic at Light brightness: what a standalone app would show.
+    fn prefs_ask_classic_light(app: &mut crate::VectorcraftApp) {
+        app.run("prefs.set", json!({"values": {"uiColorScheme": "classic", "uiBrightness": "light", "uiAccent": "pink"}})).unwrap();
+    }
+
+    #[test]
+    fn the_address_picks_the_starting_mode() {
+        assert_eq!(HanpanMode::from_query("?embedded=hanpan&theme=dark"), HanpanMode::Dark);
+        assert_eq!(HanpanMode::from_query("?theme=light&embedded=hanpan"), HanpanMode::Light);
+        assert_eq!(HanpanMode::from_query("embedded=hanpan&theme=dark"), HanpanMode::Dark);
+        assert_eq!(HanpanMode::from_query("?embedded=hanpan"), HanpanMode::Light);
+        assert_eq!(HanpanMode::from_query("?embedded=hanpan&theme=blue"), HanpanMode::Light);
+        assert_eq!(HanpanMode::from_query("?embedded=hanpan&xtheme=dark"), HanpanMode::Light);
+        assert_eq!(HanpanMode::Light.brightness(), Brightness::Light);
+        assert_eq!(HanpanMode::Dark.brightness(), Brightness::Dark);
+    }
+
+    #[test]
+    fn embedded_forces_the_hanpan_scheme() {
+        for (mode, dark) in [(HanpanMode::Dark, true), (HanpanMode::Light, false)] {
+            let ctx = egui::Context::default();
+            let mut app = app(true);
+            start_theme(&mut app, &ctx, mode);
+            assert_eq!(look(&Tokens::get(&ctx)), hanpan(dark), "{mode:?}: the first frame is already in the Hanpan scheme");
+            prefs_ask_classic_light(&mut app);
+            crate::prefs_dialog::apply_runtime(&mut app, &ctx);
+            assert_eq!(look(&Tokens::get(&ctx)), hanpan(dark), "{mode:?}: after apply_runtime");
+            crate::prefs_dialog::reapply(&mut app, &ctx);
+            assert_eq!(look(&Tokens::get(&ctx)), hanpan(dark), "{mode:?}: after reapply");
+            assert_eq!(ctx.global_style().visuals.window_fill, Tokens::hanpan(dark).panel);
+            // whole frames (the saved preferences included) keep it too
+            for _ in 0..2 {
+                let mut out = ctx.run_ui(egui::RawInput::default(), |ui| app.logic(ui.ctx()));
+                out.textures_delta.clear();
+                assert_eq!(look(&Tokens::get(&ctx)), hanpan(dark), "{mode:?}: after a frame");
+            }
+            assert_eq!(app.session.prefs.ui_color_scheme, "classic", "the saved preferences are left alone");
+        }
+    }
+
+    #[test]
+    fn not_embedded_keeps_the_prefs_scheme() {
+        let ctx = egui::Context::default();
+        let mut app = app(false);
+        prefs_ask_classic_light(&mut app);
+        crate::prefs_dialog::apply_runtime(&mut app, &ctx);
+        assert_eq!(look(&Tokens::get(&ctx)), look(&Tokens::classic(Brightness::Light)));
+        // the brightness command and `ui.set {brightness}` work as before
+        assert!(crate::menus::enabled(&app, "window.brightness"));
+        app.run("window.brightness", json!({"brightness": "dark"})).unwrap();
+        crate::prefs_dialog::apply_runtime(&mut app, &ctx);
+        assert_eq!(look(&Tokens::get(&ctx)), look(&Tokens::classic(Brightness::Dark)));
+        let reply = call(&mut app, &ctx, "ui.set", json!({"brightness": "mediumLight"}));
+        assert_eq!(reply["ok"], true, "{reply}");
+        crate::prefs_dialog::apply_runtime(&mut app, &ctx);
+        assert_eq!(app.ui.brightness, Brightness::MediumLight);
+        assert_eq!(look(&Tokens::get(&ctx)), look(&Tokens::for_scheme(Scheme::Classic, Brightness::MediumLight, Default::default())));
+    }
+
+    #[test]
+    fn hanpan_theme_switches_at_once() {
+        let ctx = egui::Context::default();
+        let mut app = app(true);
+        start_theme(&mut app, &ctx, HanpanMode::Light);
+        let reply = call(&mut app, &ctx, "hanpan.theme", json!({"mode": "dark"}));
+        assert_eq!(reply, json!({"ok": true, "result": {"mode": "dark"}}));
+        assert_eq!(look(&Tokens::get(&ctx)), hanpan(true), "the reply's frame already draws it");
+        crate::prefs_dialog::apply_runtime(&mut app, &ctx);
+        assert_eq!(look(&Tokens::get(&ctx)), hanpan(true), "the next frame keeps it");
+        let status = call(&mut app, &ctx, "hanpan.status", json!({}));
+        assert_eq!(status, json!({"ok": true, "result": {"mode": "dark", "uiFont": "NanumGothic"}}));
+        let reply = call(&mut app, &ctx, "hanpan.theme", json!({"mode": "light"}));
+        assert_eq!(reply["result"]["mode"], "light");
+        assert_eq!(look(&Tokens::get(&ctx)), hanpan(false));
+        assert_eq!(super::status(&app)["mode"], "light");
+    }
+
+    #[test]
+    fn hanpan_theme_refused_when_not_embedded() {
+        let ctx = egui::Context::default();
+        let mut app = app(false);
+        crate::prefs_dialog::apply_runtime(&mut app, &ctx);
+        let before = look(&Tokens::get(&ctx));
+        for (method, params) in [("hanpan.theme", json!({"mode": "dark"})), ("hanpan.status", json!({}))] {
+            let reply = call(&mut app, &ctx, method, params);
+            assert_eq!(reply["ok"], false, "{method}: {reply}");
+            let error = reply["error"].as_str().unwrap_or_default();
+            assert!(error.contains("embedded") && !error.contains("unknown method"), "{reply}");
+        }
+        crate::prefs_dialog::apply_runtime(&mut app, &ctx);
+        assert_eq!(look(&Tokens::get(&ctx)), before);
+    }
+
+    #[test]
+    fn hanpan_theme_rejects_unknown_mode() {
+        let ctx = egui::Context::default();
+        let mut app = app(true);
+        start_theme(&mut app, &ctx, HanpanMode::Light);
+        for params in [json!({"mode": "blue"}), json!({}), json!({"mode": 1}), json!({"mode": "Dark"})] {
+            let reply = call(&mut app, &ctx, "hanpan.theme", params.clone());
+            assert_eq!(reply["ok"], false, "{params}: {reply}");
+            assert_eq!(app.ui.hanpan_mode, HanpanMode::Light, "{params}");
+            assert_eq!(look(&Tokens::get(&ctx)), hanpan(false), "{params}");
+        }
+    }
