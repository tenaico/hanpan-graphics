+/// Hanpan: a face as the browser's font list names it (`FontData.postscriptName`, `.fullName`).
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ListedFace {
+    pub postscript: String,
+    pub full_name: String,
+}
+
+/// Hanpan: the files the shell read for the interface's Hangul face: the Regular entry's file and,
+/// when the PC has a Bold entry, its file (`None`: the Bold is in the Regular's file, a
+/// collection).
+#[derive(Clone, Debug, Default)]
+pub struct PcFaceFiles {
+    pub family: String,
+    pub regular: Vec<u8>,
+    pub regular_names: ListedFace,
+    pub bold: Option<Vec<u8>>,
+    pub bold_names: Option<ListedFace>,
+}
+
+/// Hanpan: the interface's Hangul face from `files`: in each file the face its list entry names
+/// (a collection's first face may be another weight). `None` when the Regular is not a font egui
+/// can read (egui panics on those); a Bold that is not is left out.
+pub fn ui_face(files: PcFaceFiles) -> Option<crate::theme::UiHangulFace> {
+    let PcFaceFiles { family, regular, regular_names, bold, bold_names } = files;
+    let at = |bytes: &[u8], names: &ListedFace| vectorcraft_text::named_face_index(bytes, &names.postscript, &names.full_name);
+    let index = at(&regular, &regular_names)?;
+    let regular = egui::FontData { index, ..egui::FontData::from_owned(regular) };
+    let bold = bold_names.and_then(|names| {
+        let data = match bold {
+            Some(bytes) => at(&bytes, &names).map(|index| egui::FontData { index, ..egui::FontData::from_owned(bytes) }),
+            // the same file: its bytes shared, not copied
+            None => at(regular.bytes(), &names).map(|index| egui::FontData::from_blob(regular.font.clone(), index)),
+        };
+        if data.is_none() {
+            log::warn!("local fonts: no readable {family} Bold; semibold Hangul uses the Regular");
+        }
+        data.map(std::sync::Arc::new)
+    });
+    Some(crate::theme::UiHangulFace { family, regular: std::sync::Arc::new(regular), bold })
+}
+
+/// Hanpan: the shell read the PC face's files (embedded mode): from the next pass the interface
+/// draws Hangul in it. The interface's fonts are set again as when the graphics restart (the
+/// fallbacks `ui_fonts` added go, and are added again for what the face lacks), and every later
+/// context gets it too. False, and nothing changes, outside Hanpan or when they are not readable
+/// fonts.
+pub fn install_ui_face(app: &mut crate::VectorcraftApp, ctx: &egui::Context, files: PcFaceFiles) -> bool {
+    if !app.services.embedded {
+        return false;
+    }
+    let family = files.family.clone();
+    let Some(face) = ui_face(files) else {
+        log::warn!("local fonts: {family} is not a readable font; the interface keeps NanumGothic");
+        return false;
+    };
+    app.ui_hangul_face = Some(face);
+    app.fonts_ready = false;
+    app.ui_fonts = Default::default();
+    ctx.request_repaint();
+    true
+}
