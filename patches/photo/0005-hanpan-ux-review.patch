+/// 문서에 저장되는 이름은 그대로 두고 그릴 때만 바꾼다(PSD 호환, 엔진·자동화 테스트 유지).
+pub fn default_name(name: &str) -> std::borrow::Cow<'_, str> {
+    use std::borrow::Cow;
+    if name == "Background" {
+        return Cow::Borrowed(tr(current(), "Background"));
