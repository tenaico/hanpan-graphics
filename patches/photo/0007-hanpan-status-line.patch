+    /// Hanpan W3: an engine refusal on the status line reads as a sentence in the interface
+    /// language (the command's name and what to do), never "command `…` is not available right
+    /// now: …".
+    #[test]
+    fn hanpan_engine_refusals_read_in_the_interface_language() {
+        let ko = crate::i18n::Lang::from_code("ko").expect("ko registered");
+        let vi = crate::i18n::Lang::from_code("vi").expect("vi registered");
+        let engine = "command `image.autoTone` is not available right now: the active layer has no pixels";
+        crate::i18n::with_language(ko, || {
+            assert_eq!(shown_status_line(engine, true), "자동 톤: 지금은 할 수 없습니다. 그림(픽셀)이 있는 레이어를 고르세요. 문자·모양 레이어에는 쓸 수 없습니다.");
+            // a reason with no translation is left out, not shown in English
+            assert_eq!(shown_status_line("command `image.autoTone` is not available right now: some new reason", true), "자동 톤: 지금은 할 수 없습니다.");
+            // the engine's other errors, and any error left in English, become one plain sentence
+            assert_eq!(shown_status_line("invalid parameters for `image.autoTone`: amount must be a number", true), "이 작업을 하지 못했습니다.");
+            assert_eq!(shown_status_line("Couldn't read photo.psd: unexpected end of file", true), "이 작업을 하지 못했습니다.");
+            // the user's own words and file names are left alone
+            assert_eq!(shown_status_line("photo.psd 저장됨", false), "photo.psd 저장됨");
+            assert_eq!(shown_status_line("photo.psd", false), "photo.psd");
+            // h5's hint for painting with no layer stays
+            assert_eq!(shown_status_line("command `paint.stroke` is not available right now: no active layer", true), tl!(NO_LAYER_HINT));
+        });
+        crate::i18n::with_language(vi, || {
+            let shown = shown_status_line(engine, true);
+            assert!(shown.starts_with("Tự chỉnh tông: "), "{shown}");
+            assert!(!shown.contains("command") && !shown.contains("not available") && !shown.contains('`'), "{shown}");
+        });
+        // English keeps a sentence too, without the command id
+        let en = shown_status_line(engine, true);
+        assert!(en.starts_with("Auto Tone: ") && !en.contains('`'), "{en}");
+        assert_eq!(shown_status_line("Couldn't read photo.psd: unexpected end of file", true), "Couldn't read photo.psd: unexpected end of file");
+    }
+
+    /// Hanpan W3: a shortcut whose command is off says so in the interface language, with no
+    /// English reason ("인쇄 is not available: not available on the web (no file system)").
+    #[test]
+    fn hanpan_a_disabled_shortcut_says_why_in_the_interface_language() {
+        use serde_json::json;
+        let ko = crate::i18n::Lang::from_code("ko").expect("ko registered");
+        let mut app = crate::PhotocraftApp::new(photocraft_engine::Session::new(), Default::default());
+        app.session.execute("file.new", json!({"width": 32, "height": 32})).unwrap();
+        // a group has no pixels of its own
+        app.session.execute("layer.new.group", json!({})).unwrap();
+        crate::i18n::with_language(ko, || {
+            crate::shortcut_dispatch::dispatch(&mut app, &egui::Context::default(), "image.autoTone");
+            assert!(app.ui.status_error);
+            assert_eq!(app.ui.status, "자동 톤: 지금은 할 수 없습니다. 그림(픽셀)이 있는 레이어를 고르세요. 문자·모양 레이어에는 쓸 수 없습니다.");
+            crate::shortcut_dispatch::dispatch(&mut app, &egui::Context::default(), "file.revert");
+            assert!(!app.ui.status.contains("is not available") && !app.ui.status.contains("not available on the web"), "{}", app.ui.status);
+        });
+    }
