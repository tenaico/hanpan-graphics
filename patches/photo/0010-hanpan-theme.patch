+/// Hanpan: the host's theme, light or dark (`hanpan.theme {mode}` and the page address's
+/// `theme=light|dark`). Inside Hanpan PhotoCraft draws only [`ThemeKind::HanpanLight`] or
+/// [`ThemeKind::HanpanDark`]; its own theme preferences are kept but not shown.
+///
+/// [`ThemeKind::HanpanLight`]: crate::theme::ThemeKind::HanpanLight
+/// [`ThemeKind::HanpanDark`]: crate::theme::ThemeKind::HanpanDark
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum HanpanMode {
+    #[default]
+    Light,
+    Dark,
+}
+
+impl HanpanMode {
+    pub fn from_name(name: &str) -> Option<Self> {
+        match name {
+            "light" => Some(Self::Light),
+            "dark" => Some(Self::Dark),
+            _ => None,
+        }
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Light => "light",
+            Self::Dark => "dark",
+        }
+    }
+
+    pub fn kind(self) -> crate::theme::ThemeKind {
+        match self {
+            Self::Light => crate::theme::ThemeKind::HanpanLight,
+            Self::Dark => crate::theme::ThemeKind::HanpanDark,
+        }
+    }
+
+    /// The page query's `theme=light|dark` (`location.search`, with or without its `?`); light
+    /// when it is missing or another value.
+    pub fn from_query(query: &str) -> Self {
+        query.trim_start_matches('?').split('&').find_map(|kv| kv.strip_prefix("theme=")).and_then(Self::from_name).unwrap_or_default()
+    }
+}
+
+/// The interface font `hanpan.status` reports (Task 3 makes it the PC's Korean font).
+pub const UI_FONT: &str = "NanumGothic";
+
+/// The error `hanpan.theme` and `hanpan.status` give outside Hanpan.
+pub const NOT_EMBEDDED: &str = "only available in embedded mode (?embedded=hanpan)";
+
+/// The theme embedded mode draws: the host's mode as a Hanpan theme.
+pub fn hanpan_kind(app: &crate::PhotocraftApp) -> crate::theme::ThemeKind {
+    app.ui.hanpan_mode.kind()
+}
+
+/// The first frame's theme: `mode` from the page address, applied before anything is drawn and
+/// without touching the saved theme preferences.
+pub fn start_theme(app: &mut crate::PhotocraftApp, ctx: &egui::Context, mode: HanpanMode) {
+    app.ui.hanpan_mode = mode;
+    app.apply_theme(ctx, mode.kind());
+}
+
+/// `hanpan.theme {mode: "light" | "dark"}`: switch at once (the reply's frame already draws it);
+/// the documents and the saved preferences are left alone. Reply `{mode}`.
+pub fn set_theme(app: &mut crate::PhotocraftApp, ctx: &egui::Context, params: &serde_json::Value) -> Result<serde_json::Value, String> {
+    if !app.services.embedded {
+        return Err(format!("hanpan.theme is {NOT_EMBEDDED}"));
+    }
+    let mode = match params.get("mode") {
+        Some(serde_json::Value::String(name)) => HanpanMode::from_name(name).ok_or_else(|| format!("unknown mode `{name}` (light, dark)"))?,
+        Some(_) => return Err("`mode` must be \"light\" or \"dark\"".into()),
+        None => return Err("missing `mode` (light, dark)".into()),
+    };
+    app.ui.hanpan_mode = mode;
+    let kind = hanpan_kind(app);
+    if app.ui.theme != kind {
+        app.apply_theme(ctx, kind);
+    }
+    ctx.request_repaint();
+    Ok(serde_json::json!({"mode": mode.name()}))
+}
+
+/// `hanpan.status {}`: `{mode, uiFont}`.
+pub fn status(app: &crate::PhotocraftApp) -> serde_json::Value {
+    serde_json::json!({"mode": app.ui.hanpan_mode.name(), "uiFont": UI_FONT})
+}
