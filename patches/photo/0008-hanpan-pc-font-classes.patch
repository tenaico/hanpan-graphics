+    fn hanpan_a_class_filter_lists_the_pc_fonts_of_that_class() {
+        use photocraft_text::FontClass;
+        let all: Vec<String> = ["Arial", "Batang", "Ink Free", "Segoe Print", "Times New Roman", "Inter"].map(String::from).to_vec();
+        let known = vec!["Inter".to_string()];
