+/// Hanpan: the PC's own face for Hangul in the interface on `platform` (`navigator.platform`
+/// or `navigator.userAgentData.platform`): Malgun Gothic on Windows, Apple SD Gothic Neo on a
+/// Mac, none elsewhere (NanumGothic draws it).
+pub fn ui_face_for_platform(platform: &str) -> Option<&'static str> {
+    let p = platform.to_ascii_lowercase();
+    if p.starts_with("win") {
+        Some("Malgun Gothic")
+    } else if p.starts_with("mac") {
+        Some("Apple SD Gothic Neo")
+    } else {
+        None
+    }
+}
+
+/// Hanpan: `family` as the PC's list names it, if it is there.
+pub fn ui_face_in_listing(families: &[String], family: &str) -> Option<String> {
+    families.iter().find(|f| f.eq_ignore_ascii_case(family)).cloned()
+}
+
+/// Hanpan: asks for the PC's `family` to draw the interface's Hangul (embedded mode, at
+/// startup). It is read with the list, and only for the interface: it is not added to the font
+/// database, so the documents' fonts and their substitution do not change. Missing or refused,
+/// NanumGothic goes on drawing Hangul.
+pub fn want_ui_face(family: &str) {
+    want_ui_face_into(&mut state(), family);
+}
+
+fn want_ui_face_into(s: &mut State, family: &str) {
+    if !s.enabled {
+        return;
+    }
+    match &s.listing {
+        Listing::Listed(all) => {
+            s.ui_request = ui_face_in_listing(all, family);
+        }
+        _ => {
+            s.ui_face = Some(family.to_string());
+            if !matches!(s.listing, Listing::Pending) {
+                s.listing = Listing::Pending;
+                s.list_requested = true;
+                s.ui_list_only = true;
+            }
+        }
+    }
+    s.generation = s.generation.wrapping_add(1);
+}
+
+/// For the shell: the PC face to read for the interface now, once.
+pub fn take_ui_face_request() -> Option<String> {
+    state().ui_request.take()
+}
