+/// Hanpan: inside Hanpan the theme is the host's. Preferences › User Interface shows no
+/// Brightness, Color Scheme or Accent Color; Canvas Color and the rest stay. Standalone keeps all.
+#[test]
+fn hanpan_embedded_hides_the_theme_rows() {
+    let rows = ["Brightness:", "Color Scheme:", "Accent Color:"];
+    for embedded in [false, true] {
+        let mut a = VectorcraftApp::new(Session::new(), Services { embedded, ..Default::default() });
+        open(&mut a, Some("User Interface"));
+        let text = crate::tests_labels::painted_text(&mut a, |a, ui| show(a, ui.ctx()));
+        assert!(text.contains("Canvas Color:"), "embedded={embedded}: {text}");
+        for row in rows {
+            let shown = text.lines().any(|l| l.trim() == row);
+            assert_eq!(shown, !embedded, "embedded={embedded}: {row}\n{text}");
+        }
