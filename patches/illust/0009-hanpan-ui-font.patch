+/// Hanpan: a stand-in for a PC's Hangul face (Malgun Gothic, Apple SD Gothic Neo): the bundled
+/// Source Sans 3 Regular as `family` in `style` (full name `<family> <style>`, PostScript name
+/// `postscript`), with every Hangul syllable drawn as its `A`. `None` when it can't be built.
+pub fn hangul_font(family: &str, style: &str, postscript: &str) -> Option<Vec<u8>> {
+    const FACE: &[u8] = include_bytes!("../../../assets/fonts/SourceSans3-Regular.ttf");
+    let font = skrifa::FontRef::new(FACE).ok()?;
+    let gid = |g: GlyphId| write_fonts::types::GlyphId::new(g.to_u32());
+    let a = gid(font.charmap().map('A')?);
+    let mappings = font.charmap().mappings().filter_map(|(c, g)| Some((char::from_u32(c)?, gid(g))));
+    let hangul = ('\u{AC00}'..='\u{D7A3}').map(|c| (c, a));
+    let cmap = write_fonts::tables::cmap::Cmap::from_mappings(mappings.chain(hangul)).ok()?;
+    let full = format!("{family} {style}");
+    let name = name_table(&[(1, family), (2, style), (4, &full), (5, "Version 1.000"), (6, postscript)])?;
+    let mut builder = FontBuilder::new();
+    builder.add_raw(Tag::new(b"name"), name);
+    builder.add_table(&cmap).ok()?;
+    for r in font.table_directory.table_records() {
+        let tag = Tag::new(&r.tag().to_be_bytes());
+        if !builder.contains(tag) {
+            builder.add_raw(tag, font.table_data(r.tag())?.as_bytes());
+        }
+    }
+    Some(builder.build())
+}
+
+/// Hanpan: `fonts` (single font files) as one collection (`.ttc`), face `i` being `fonts[i]`, as a
+/// Mac keeps a family's weights (Apple SD Gothic Neo). `None` when one is not a font file.
+pub fn collection(fonts: &[Vec<u8>]) -> Option<Vec<u8>> {
+    let header = 12 + 4 * fonts.len();
+    let mut out = Vec::new();
+    out.extend_from_slice(b"ttcf");
+    out.extend_from_slice(&0x0001_0000_u32.to_be_bytes());
+    out.extend_from_slice(&u32::try_from(fonts.len()).ok()?.to_be_bytes());
+    let mut at = header;
+    let mut bodies = Vec::new();
+    for font in fonts {
+        out.extend_from_slice(&u32::try_from(at).ok()?.to_be_bytes());
+        // the table records' offsets count from the start of the collection
+        let mut body = font.clone();
+        let tables = usize::from(u16::from_be_bytes(body.get(4..6)?.try_into().ok()?));
+        for t in 0..tables {
+            let field = 12 + 16 * t + 8;
+            let offset = u32::from_be_bytes(body.get(field..field + 4)?.try_into().ok()?);
+            body[field..field + 4].copy_from_slice(&(offset + u32::try_from(at).ok()?).to_be_bytes());
+        }
+        while body.len() % 4 != 0 {
+            body.push(0);
+        }
+        at += body.len();
+        bodies.push(body);
+    }
+    for body in bodies {
+        out.extend(body);
+    }
+    Some(out)
+}
