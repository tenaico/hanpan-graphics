+
+/// Hanpan (final review): the status bar and the line under the menu bar are the AI Word tab's
+/// status bar (`--docs-statusbar-bg`) and ribbon edge (`--border-strong`), in the Hanpan themes
+/// only; every other theme keeps the chrome fill and the panel's own separator.
+#[test]
+fn hanpan_status_bar_and_menu_bar_border_match_word() {
+    let light = Tokens::for_kind(ThemeKind::HanpanLight);
+    assert_eq!(light.status_bar_fill(), hex(0xf3f4f6));
+    assert_eq!(light.menu_bar_border(), Some(hex(0xd9d9d9)));
+    let dark = Tokens::for_kind(ThemeKind::HanpanDark);
+    assert_eq!(dark.status_bar_fill(), hex(0x252525));
+    assert_eq!(dark.menu_bar_border(), Some(hex(0x555555)));
+    for kind in ThemeKind::ALL {
+        let t = Tokens::for_kind(kind);
+        assert_eq!(t.status_bar_fill(), t.chrome, "{kind:?}");
+        assert_eq!(t.menu_bar_border(), None, "{kind:?}");
+    }
+}
