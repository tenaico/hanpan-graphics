+/// Hanpan: does a press with painting tool `tool` find no layer to paint on (every layer
+/// deselected)? The Move tool is left alone: its Auto-Select picks the layer under the pointer.
+fn no_target_layer(app: &PhotocraftApp, tool: Tool) -> bool {
+    let cmd = match tool {
+        Tool::Gradient if !app.ui.tool_options.gradient_classic => return false,
+        t if t.is_brushlike() || matches!(t, Tool::PaintBucket | Tool::MagicEraser) => "paint.stroke",
+        Tool::Gradient => "paint.stroke",
+        _ => return false,
+    };
+    photocraft_engine::hidden_target::no_target_layer(&app.session, cmd, &json!({}))
+}
