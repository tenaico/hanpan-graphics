+
+/// 한판 W9: 한국어·베트남어 화면에서는 새 문서 기본이 A4(mm), 인쇄 프리셋은 A4가 맨 앞이고 mm로
+/// 보이며 RGB로 만든다(사무용 프린터·화면 공유용). 영어 화면은 레터·pt·CMYK 그대로다.
+#[test]
+fn korean_interface_starts_on_a4_in_millimetres_and_rgb() {
+    let mut s = Session::new();
+    s.ui_language = Some("ko".into());
+    let print = presets(&mut s, "Print");
+    assert_eq!(print[0]["name"], "A4");
+    assert_eq!(print.len(), 8);
+    assert_eq!(print[0]["units"], "Millimeters");
+    assert_eq!(print[0]["colorMode"], "rgb");
+    s.execute("file.new", &json!({})).unwrap();
+    let d = &s.doc().unwrap().doc;
+    assert_eq!((d.units, d.color_mode), (Unit::Millimeters, ColorMode::Rgb));
+    assert!((boards(&s)[0].width() - 595.2756).abs() < 0.01, "A4 width");
+    s.execute("file.new", &json!({"preset": "Letter"})).unwrap();
+    assert_eq!(s.doc().unwrap().doc.color_mode, ColorMode::Rgb);
+
+    let mut s = Session::new();
+    s.ui_language = Some("en".into());
+    let print = presets(&mut s, "Print");
+    assert_eq!((print[0]["name"].as_str(), print[0]["colorMode"].as_str()), (Some("Letter"), Some("cmyk")));
+}
