+/// Hanpan: `s`, a built-in name or text of the app's own (a preset, a colour profile, a preset's
+/// description) that its place shows as it is: inside Hanpan in `lang` (its catalog row, with
+/// Hanpan's name for the app, [`tr`]); outside Hanpan exactly as before. Never for user data.
+pub fn builtin_shown(lang: Lang, s: &str) -> &str {
+    if host_names() { tr(lang, s) } else { s }
+}
+
+/// Hanpan: is `name` one of the colour profiles built into the app ("VectorCraft Generic CMYK
+/// (SWOP-like)" …), which [`builtin_shown`] shows in the UI language inside Hanpan? Always
+/// `false` outside Hanpan, so the profile lists read as before there.
+pub fn hosted_builtin_profile(name: &str) -> bool {
+    host_names() && vectorcraft_color::cms::profiles().iter().any(|p| p.builtin && p.name == name)
+}
+
+/// Hanpan: is `source` (an English text or a command id) one whose text keeps the name?
+fn keeps_name(source: &str) -> bool {
+    source == "help.about" || KEEP_NAME.contains(&source)
+}
+
+/// Hanpan: [`rename_text`] for a lookup's result: `source` is the English text (or command id) it
+/// was looked up by, `english` whether `text` is that English text. A renamed text is built once
+/// per thread and kept (it is a catalog entry or an English UI string, a bounded set), so drawing
+/// it every frame allocates nothing. Past [`MAX_RENAMED`] texts (the catalogs hold about 50 per
+/// language) a new text is shown cut to its longest part without the name, and the console says
+/// so once: never the name, never a leak per frame.
+fn hosted<'a>(lang: Lang, source: &str, text: &'a str, english: bool) -> &'a str {
+    if !host_names() || !text.contains(APP_NAME) || keeps_name(source) {
+        return text;
+    }
+    thread_local! {
+        // [other languages, Korean] × [translation, English]: renamed text by the text it was made from
+        static RENAMED: std::cell::RefCell<[std::collections::HashMap<Box<str>, &'static str>; 4]> = Default::default();
+        static FULL_NOTED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    }
+    RENAMED.with(|renamed| -> &'a str {
+        let mut renamed = renamed.borrow_mut();
+        let table = &mut renamed[usize::from(lang.code() == "ko") * 2 + usize::from(english)];
+        if let Some(&done) = table.get(text) {
+            return done;
+        }
+        if table.len() >= rename_limit() {
+            if !FULL_NOTED.replace(true) {
+                log::warn!("hanpan: over {} texts name the app; {text:?} and later ones are cut short", rename_limit());
+            }
+            return without_name(text);
+        }
+        let done: &'static str = Box::leak(rename_text(lang, text, english).into_owned().into_boxed_str());
+        table.insert(text.into(), done);
+        done
+    })
+}
+
+/// The longest part of `text` between the app's names (case endings dropped), trimmed.
+fn without_name(text: &str) -> &str {
+    text.split(APP_NAME)
+        .enumerate()
+        .map(|(i, part)| if i == 0 { part } else { part.trim_start_matches(|c: char| c.is_ascii_lowercase()) }.trim())
+        .max_by_key(|part| part.len())
+        .unwrap_or("")
+}
+
+/// Hanpan: the most renamed texts [`hosted`] keeps per thread, language and kind.
+pub const MAX_RENAMED: usize = 4096;
+
+#[cfg(test)]
+thread_local!(static RENAME_LIMIT: std::cell::Cell<usize> = const { std::cell::Cell::new(MAX_RENAMED) });
+
+fn rename_limit() -> usize {
+    #[cfg(test)]
+    return RENAME_LIMIT.get();
+    #[cfg(not(test))]
+    MAX_RENAMED
+}
+
+/// Hanpan (tests): lower [`MAX_RENAMED`] on this thread.
+#[cfg(test)]
+pub fn set_rename_limit(limit: usize) {
+    RENAME_LIMIT.set(limit);
+}
+
+/// Hanpan: every English message template the catalogs know (each `@msg` source, each English
+/// form of a `@msgplural` row) and [`ENGINE_MESSAGES`], each its own translation: a message in a
+/// language with no row for it, or in English, is split into its own words and its values by
+/// these. Read once, the first time a message naming the app needs it.
+fn english_messages() -> &'static Catalog {
+    static ENGLISH: OnceLock<Catalog> = OnceLock::new();
+    ENGLISH.get_or_init(|| {
+        let mut seen = std::collections::HashSet::new();
+        let sources = LANGUAGES
+            .iter()
+            .flat_map(|l| catalog::parse_entries(l.source).0)
+            .flat_map(|(ctx, src, _)| match ctx.as_str() {
+                "@msg" => vec![src],
+                "@msgplural" => src.split('|').map(str::to_string).collect(),
+                _ => vec![],
+            })
+            .chain(ENGINE_MESSAGES.iter().map(|s| s.to_string()))
+            .filter(|src| seen.insert(src.clone()))
+            .map(|src| ("@msg".to_string(), src.clone(), src))
+            .collect::<Vec<_>>();
+        Catalog::from_entries(sources)
+    })
+}
