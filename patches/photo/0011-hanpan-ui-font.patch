+}
+
+/// Hanpan: asks for the PC's `family` to draw the interface's Hangul (embedded mode, at
+/// startup). It is read with the list, and only for the interface: the documents' fonts and
+/// their substitution do not change. Missing or refused, NanumGothic goes on drawing Hangul.
+pub fn want_ui_face(family: &str) {
+    let mut s = state();
+    if !s.enabled {
+        return;
+    }
+    match &s.listing {
+        Listing::Listed(all) => {
+            s.ui_request = ui_face_in_listing(all, family);
+        }
+        _ => {
+            s.ui_face = Some(family.to_string());
+            if !matches!(s.listing, Listing::Pending) {
+                s.listing = Listing::Pending;
+                s.list_requested = true;
+                s.ui_list_only = true;
+            }
+        }
+    }
+    s.generation = s.generation.wrapping_add(1);
+}
+
+/// For the shell: the PC face to read for the interface now, once.
+pub fn take_ui_face_request() -> Option<String> {
+    state().ui_request.take()
+}
+
+/// Hanpan: the interface's Hangul face from the PC's `family` files (Regular, and Bold if the
+/// PC has one); `None` when a file is not a font egui can read (egui panics on those).
+pub fn ui_face(family: &str, regular: Vec<u8>, bold: Option<Vec<u8>>) -> Option<crate::theme::UiHangulFace> {
+    let data = |bytes: Vec<u8>| -> Option<std::sync::Arc<egui::FontData>> {
+        // a collection (.ttc): the family's face; a single file: its only one
+        let index = photocraft_text::cjk::face_index_for_family_checked(&bytes, family).unwrap_or(0);
+        if bytes.is_empty() || !photocraft_text::cjk::font_face_is_readable(&bytes, index) {
+            return None;
+        }
+        let mut data = egui::FontData::from_owned(bytes);
+        data.index = index;
+        Some(std::sync::Arc::new(data))
+    };
+    let regular = data(regular)?;
+    let bold = bold.and_then(|b| {
+        let d = data(b);
+        if d.is_none() {
+            log::warn!("local fonts: {family} Bold is not a readable font; semibold Hangul uses the Regular");
+        }
+        d
+    });
+    Some(crate::theme::UiHangulFace { family: family.to_string(), regular, bold })
+}
+
+/// Hanpan: the shell read the PC face's files: from the next pass the interface draws Hangul in
