diff --git a/crates/ui-egui/src/i18n/host_name_tests.rs b/crates/ui-egui/src/i18n/host_name_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c3398a28a445651147964afde010a152288fd5c8
--- /dev/null
+++ b/crates/ui-egui/src/i18n/host_name_tests.rs
@@ -0,0 +1,153 @@
+//! Hanpan: embedded mode calls the app by Hanpan's name for it ("AI 포토" in Korean, "AI Photo"
+//! in every other language) wherever the UI's text names it, except the About window.
+
+use super::catalog::parse_entries;
+use super::*;
+
+/// The languages Hanpan opens the AI Photo tab in.
+const HANPAN_LANGS: [&str; 15] = ["ko", "en", "ja", "fr", "de", "es", "id", "ru", "it", "pl", "cs", "nl", "vi", "pt-br", "ar"];
+
+fn lang(code: &str) -> Lang {
+    Lang::from_code(code).unwrap_or_else(|| panic!("{code} registered"))
+}
+
+/// Run `f` with Hanpan's names on, as an embedded frame does, and turn them off again.
+fn hosted<R>(f: impl FnOnce() -> R) -> R {
+    set_host_names(true);
+    let out = f();
+    set_host_names(false);
+    out
+}
+
+fn names_the_app(s: &str) -> bool {
+    s.contains(APP_NAME)
+}
+
+/// Every catalog entry that names the app, in every language Hanpan opens photo in, comes out
+/// without the name: plain, contextual, command-id and plural entries, and the English source
+/// column as English shows it. Only the About window's own strings keep it.
+#[test]
+fn embedded_text_never_names_the_app_except_about() {
+    let mut checked = 0usize;
+    let mut sources = std::collections::BTreeSet::new();
+    hosted(|| {
+        for code in HANPAN_LANGS {
+            let l = lang(code);
+            let text = LANGUAGES.iter().find(|i| i.code == code).map(LangInfo::text).unwrap_or_default();
+            for (ctx, src, tr_text) in parse_entries(&text).0 {
+                if ctx == "@plural" {
+                    if let Some((one, other)) = src.split_once('|') {
+                        sources.insert(one.to_string());
+                        sources.insert(other.to_string());
+                        if names_the_app(&tr_text) || names_the_app(&src) {
+                            for n in [0, 1, 2, 3, 5, 11, 21, 22, 100] {
+                                let shown = trn(l, n, one, other);
+                                assert!(!names_the_app(&shown), "{code} plural {src:?} n={n}: {shown:?}");
+                                checked += 1;
+                            }
+                        }
+                    }
+                    continue;
+                }
+                sources.insert(src.clone());
+                if !names_the_app(&tr_text) && !names_the_app(&src) {
+                    continue;
+                }
+                let kept = KEEP_NAME.contains(&src.as_str());
+                let shown = match ctx.as_str() {
+                    "" => tr(l, &src).to_string(),
+                    "@id" => tr_id(l, &src, "x").to_string(),
+                    _ => tr_ctx(l, &ctx, &src).to_string(),
+                };
+                if kept {
+                    assert_eq!(shown, tr_text, "{code}: the About window keeps the name: {src:?}");
+                } else {
+                    assert!(!names_the_app(&shown), "{code} {ctx:?} {src:?}: {shown:?}");
+                }
+                checked += 1;
+            }
+        }
+        // The English source column, as the English UI (and any language without the entry) shows it.
+        for src in &sources {
+            if !names_the_app(src) {
+                continue;
+            }
+            let shown = tr(Lang::EN, src);
+            if KEEP_NAME.contains(&src.as_str()) {
+                assert_eq!(shown, src);
+            } else {
+                assert!(!names_the_app(shown), "en {src:?}: {shown:?}");
+            }
+            checked += 1;
+        }
+    });
+    assert!(checked > 15 * 15, "only {checked} entries name the app: the catalogs moved?");
+}
+
+/// Korean reads 포토 with the particles the catalogs already put after the name (가, 를, 에서,
+/// 에, 와 suit a final vowel), and other languages read "AI Photo".
+#[test]
+fn hanpan_names_read_naturally() {
+    let ko = lang("ko");
+    hosted(|| {
+        assert_eq!(
+            tr(ko, "{n} commands are not in PhotoCraft."),
+            "명령 {n}개는 AI 포토에 없습니다."
+        );
+        assert_eq!(tr(ko, "PhotoCraft Manages Colors"), "AI 포토에서 색상 관리");
+        assert_eq!(tr(ko, "Nothing to paste: PhotoCraft can't read the system clipboard here"), "붙여넣을 내용 없음: 여기서는 AI 포토가 시스템 클립보드를 읽을 수 없습니다");
+        assert_eq!(tr(ko, "To drop files, start PhotoCraft under XWayland: `{command}`"), "파일을 끌어다 놓으려면 XWayland에서 AI 포토를 실행하세요: `{command}`");
+        assert_eq!(tr(ko, "PhotoCraft Defaults"), "AI 포토 기본값");
+        assert_eq!(tr(Lang::EN, "PhotoCraft Defaults"), "AI Photo Defaults");
+        assert_eq!(tr(lang("fr"), "{n} commands are not in PhotoCraft."), tr_plain_renamed("fr", "{n} commands are not in PhotoCraft.", "AI Photo"));
+        // A case ending stuck to the name goes with it: "AI Photo" is not declined.
+        assert_eq!(rename(lang("cs"), "v PhotoCraftu.").as_ref(), "v AI Photo.");
+        // The About window keeps the original name.
+        assert_eq!(tr(ko, "About PhotoCraft"), "PhotoCraft 정보");
+        assert_eq!(tr_id(ko, "help.about", "About PhotoCraft"), "PhotoCraft 정보");
+        assert_eq!(tr(Lang::EN, "About PhotoCraft"), "About PhotoCraft");
+        // Lower-case identifiers (command lines, file names) are not the name shown to people.
+        assert_eq!(rename(Lang::EN, "flatpak run ai.storyteller.photocraft").as_ref(), "flatpak run ai.storyteller.photocraft");
+    });
+}
+
+fn tr_plain_renamed(code: &str, src: &str, name: &str) -> String {
+    let text = LANGUAGES.iter().find(|i| i.code == code).map(LangInfo::text).unwrap_or_default();
+    let (_, _, t) = parse_entries(&text).0.into_iter().find(|(c, s, _)| c.is_empty() && s == src).unwrap_or_else(|| panic!("{code}: {src:?}"));
+    t.replace(APP_NAME, name)
+}
+
+/// The same text looked up again is the same interned string: no allocation per frame.
+#[test]
+fn renamed_text_is_interned_once() {
+    let ko = lang("ko");
+    hosted(|| {
+        let a = tr(ko, "PhotoCraft Defaults");
+        let b = tr(ko, "PhotoCraft Defaults");
+        assert!(std::ptr::eq(a, b), "the second lookup reuses the first string");
+        let en = tr(Lang::EN, "PhotoCraft Defaults");
+        assert_eq!(en, "AI Photo Defaults", "Korean and other languages are interned apart");
+    });
+}
+
+/// Outside Hanpan every string keeps the name, exactly as before.
+#[test]
+fn not_embedded_keeps_the_brand() {
+    let ko = lang("ko");
+    assert!(!host_names());
+    assert_eq!(tr(ko, "{n} commands are not in PhotoCraft."), "명령 {n}개는 PhotoCraft에 없습니다.");
+    assert_eq!(tr(Lang::EN, "PhotoCraft Defaults"), "PhotoCraft Defaults");
+    assert_eq!(tr_ctx(lang("de"), "smartSvg", "PhotoCraft (internal editor)"), "PhotoCraft (interner Editor)");
+    assert_eq!(trn(Lang::EN, 2, "{n} step has no PhotoCraft equivalent yet", "{n} steps have no PhotoCraft equivalent yet"), "2 steps have no PhotoCraft equivalent yet");
+    assert_eq!(rename(Lang::EN, "PhotoCraft").as_ref(), "PhotoCraft");
+}
+
+/// The new document card's "Default Size", in the languages Hanpan's photo catalogs carry it.
+#[test]
+fn default_size_is_translated() {
+    assert_eq!(tr(lang("ko"), "Default Size"), "기본 크기");
+    assert_eq!(tr(lang("vi"), "Default Size"), "Kích thước mặc định");
+    for code in HANPAN_LANGS.iter().filter(|c| **c != "en") {
+        assert!(has(lang(code), "Default Size"), "{code}");
+    }
+}
