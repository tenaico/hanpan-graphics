+/// Hanpan W5: a PC font's class guessed from its family name (its files are only read once it is
+/// picked); `None` when the name doesn't tell.
+pub fn guess_class(family: &str) -> Option<photocraft_text::FontClass> {
+    // Words, split at spaces and punctuation and where case changes: "GulimChe" is gulim + che,
+    // "HYGothic" hy + gothic.
+    let chars: Vec<char> = family.chars().collect();
+    let mut words: Vec<String> = Vec::new();
+    let mut word = String::new();
+    for (i, &c) in chars.iter().enumerate() {
+        if !c.is_alphanumeric() {
+            if !word.is_empty() {
+                words.push(std::mem::take(&mut word));
+            }
+            continue;
+        }
+        let prev = i.checked_sub(1).and_then(|p| chars.get(p)).copied();
+        let next = chars.get(i + 1).copied();
+        let split = c.is_uppercase()
+            && prev.is_some_and(|p| p.is_lowercase() || p.is_ascii_digit() || (p.is_uppercase() && next.is_some_and(char::is_lowercase)));
+        if split && !word.is_empty() {
+            words.push(std::mem::take(&mut word));
+        }
+        word.extend(c.to_lowercase());
+    }
+    if !word.is_empty() {
+        words.push(word);
+    }
+    let spaced = format!(" {} ", words.join(" "));
+    let lower = family.to_lowercase();
+    let has = |key: &&str| {
+        if !key.is_ascii() {
+            lower.contains(*key)
+        } else if key.contains(' ') {
+            spaced.contains(&format!(" {key} "))
+        } else {
+            words.iter().any(|w| w == key || (key.len() >= 6 && w.starts_with(*key)))
+        }
+    };
+    CLASS_WORDS.iter().find(|(_, keys)| keys.iter().any(has)).map(|(class, _)| *class)
+}
