new file mode 100644
index 0000000..9e972b0
--- /dev/null
+++ b/apps/vectorcraft-web/src/local_fonts.rs
@@ -0,0 +1,121 @@
+//! Hanpan: the PC's fonts for the font menus' "이 PC의 글꼴" section (embedded mode,
+//! `vectorcraft_ui_egui::local_fonts`). The browser's Local Font Access API
+//! (`window.queryLocalFonts()`, Chromium and Electron) lists them when a font menu first opens;
+//! a family picked there has its files read (`FontData.blob()`) and added to the font database,
+//! where the canvas, PNG export and SVG outlines or embedded fonts use them like any other font.
+
+use std::cell::RefCell;
+use std::collections::{HashMap, HashSet};
+
+use js_sys::{Array, Function, Promise, Reflect, Uint8Array};
+use vectorcraft_text::FontDb;
+use vectorcraft_ui_egui::local_fonts;
+use wasm_bindgen::{JsCast as _, JsValue};
+use wasm_bindgen_futures::JsFuture;
+
+thread_local! {
+    /// The `FontData` objects of each family the list gave, by family.
+    static FACES: RefCell<HashMap<String, Vec<JsValue>>> = RefCell::new(HashMap::new());
+}
+
+/// Called every frame: reads the list or loads the families the menus asked for.
+pub fn poll(ctx: &egui::Context) {
+    if local_fonts::take_list_request() {
+        let ctx = ctx.clone();
+        wasm_bindgen_futures::spawn_local(async move {
+            let result = list().await;
+            if let Err(e) = &result {
+                log::warn!("local fonts: {e}");
+            }
+            local_fonts::listed(result);
+            ctx.request_repaint();
+        });
+    }
+    for family in local_fonts::take_requests() {
+        let ctx = ctx.clone();
+        wasm_bindgen_futures::spawn_local(async move {
+            let result = load(&family).await;
+            match &result {
+                Ok(names) => log::info!("local fonts: {family} registered {names:?}"),
+                Err(e) => log::warn!("local fonts: {family}: {e}"),
+            }
+            local_fonts::finished(&family, result);
+            ctx.request_repaint();
+        });
+    }
+}
+
+/// `queryLocalFonts()`, grouped by family into [`FACES`]; the families.
+async fn list() -> Result<Vec<String>, String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let query = Reflect::get(&window, &JsValue::from_str("queryLocalFonts")).map_err(js)?;
+    let Some(query) = query.dyn_ref::<Function>() else {
+        return Err("이 브라우저는 PC 글꼴 목록(Local Font Access)을 지원하지 않습니다".into());
+    };
+    let promise: Promise = query.call0(&window).map_err(js)?.dyn_into().map_err(js)?;
+    let fonts = Array::from(&JsFuture::from(promise).await.map_err(js)?);
+    let mut by_family: HashMap<String, Vec<JsValue>> = HashMap::new();
+    for font in fonts.iter() {
+        let family = Reflect::get(&font, &JsValue::from_str("family")).ok().and_then(|f| f.as_string()).unwrap_or_default();
+        if !family.trim().is_empty() {
+            by_family.entry(family).or_default().push(font);
+        }
+    }
+    let families: Vec<String> = by_family.keys().cloned().collect();
+    log::info!("local fonts: {} families, {} faces", families.len(), fonts.length());
+    FACES.with(|f| *f.borrow_mut() = by_family);
+    Ok(families)
+}
+
+/// Read `family`'s files and add them to the font database. The family names they registered
+/// (a family already there counts as registered).
+async fn load(family: &str) -> Result<Vec<String>, String> {
+    let faces = FACES.with(|f| f.borrow().get(family).cloned()).unwrap_or_default();
+    if faces.is_empty() {
+        return Err("목록에 없는 글꼴".into());
+    }
+    let db = FontDb::global();
+    let before: HashSet<String> = db.family_list().iter().map(|f| f.to_lowercase()).collect();
+    // A collection (.ttc) is one file for several faces: read it once.
+    let mut seen: HashSet<(usize, u64)> = HashSet::new();
+    let mut errors = Vec::new();
+    for face in faces {
+        match bytes_of(&face).await {
+            Ok(bytes) => {
+                if seen.insert((bytes.len(), fingerprint(&bytes))) {
+                    db.add_font(bytes);
+                }
+            }
+            Err(e) => errors.push(e),
+        }
+    }
+    let mut names: Vec<String> = db.family_list().iter().filter(|f| !before.contains(&f.to_lowercase())).cloned().collect();
+    if before.contains(&family.to_lowercase()) || db.family_list().iter().any(|f| f.eq_ignore_ascii_case(family)) {
+        names.retain(|n| !n.eq_ignore_ascii_case(family));
+        names.insert(0, family.to_string());
+    }
+    if names.is_empty() {
+        return Err(errors.first().cloned().unwrap_or_else(|| "글꼴 파일을 읽지 못했습니다".into()));
+    }
+    Ok(names)
+}
+
+/// `await fontData.blob()` as bytes.
+async fn bytes_of(face: &JsValue) -> Result<Vec<u8>, String> {
+    let blob_fn: Function = Reflect::get(face, &JsValue::from_str("blob")).map_err(js)?.dyn_into().map_err(js)?;
+    let promise: Promise = blob_fn.call0(face).map_err(js)?.dyn_into().map_err(js)?;
+    let blob: web_sys::Blob = JsFuture::from(promise).await.map_err(js)?.dyn_into().map_err(js)?;
+    let buffer = JsFuture::from(blob.array_buffer()).await.map_err(js)?;
+    Ok(Uint8Array::new(&buffer).to_vec())
+}
+
+/// FNV-1a over the first 64 KiB: tells files of the same length apart.
+fn fingerprint(bytes: &[u8]) -> u64 {
+    bytes.iter().take(64 * 1024).fold(0xcbf2_9ce4_8422_2325_u64, |h, b| (h ^ u64::from(*b)).wrapping_mul(0x0100_0000_01b3))
+}
+
+fn js(e: JsValue) -> String {
+    e.as_string()
+        .or_else(|| Reflect::get(&e, &JsValue::from_str("message")).ok().and_then(|m| m.as_string()))
+        .unwrap_or_else(|| format!("{e:?}"))
+}
