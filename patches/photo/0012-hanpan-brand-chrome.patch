+
+// ----------------------------------------------------------------------------- Hanpan: app name
+
+/// Hanpan: the app's own name, as the UI's English text and the catalogs write it.
+pub const APP_NAME: &str = "PhotoCraft";
+
+/// Hanpan: English sources that keep the original name in embedded mode: the About window's
+/// title (also the Help menu item) and its product line. The credit sentence under them is not
+/// translated and never passes through here.
+pub const KEEP_NAME: &[&str] = &["About PhotoCraft", "PhotoCraft — an open-source, native image editor written in Rust."];
+
+thread_local! {
+    // Hanpan: embedded mode calls the app by Hanpan's name (set per frame, like the language).
+    static HOST_NAMES: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Hanpan: draw this thread's UI text with Hanpan's name for the app (`true` in embedded mode;
+/// the frame sets it from `Services::embedded`, next to the language).
+pub fn set_host_names(on: bool) {
+    HOST_NAMES.set(on);
+}
+
+/// Hanpan: is this thread's UI text drawn with Hanpan's name for the app?
+pub fn host_names() -> bool {
+    HOST_NAMES.get()
+}
+
+/// Hanpan: what Hanpan calls the app in `lang`: "AI 포토" in Korean, "AI Photo" in every other
+/// language (Hanpan's own UI uses the English name outside Korean). The catalogs' Korean particles
+/// after the name (가, 를, 에서, 에, 와) already suit 포토's final vowel.
+pub fn host_app_name(lang: Lang) -> &'static str {
+    if lang.code() == "ko" { "AI 포토" } else { "AI Photo" }
+}
+
+/// Hanpan: `text` in `lang` with [`APP_NAME`] as Hanpan calls the app, when [`host_names`] is on
+/// (otherwise, or without the name, `text` itself). A case ending stuck to the name (Czech
+/// "PhotoCraftu") goes with it: "AI Photo" is not declined. Lower-case identifiers such as
+/// `ai.storyteller.photocraft` are not the name shown to people and stay.
+pub fn rename(lang: Lang, text: &str) -> std::borrow::Cow<'_, str> {
+    if !host_names() || !text.contains(APP_NAME) {
+        return std::borrow::Cow::Borrowed(text);
+    }
+    let name = host_app_name(lang);
+    let mut out = String::with_capacity(text.len());
+    let mut rest = text;
+    while let Some(at) = rest.find(APP_NAME) {
+        out.push_str(&rest[..at]);
+        out.push_str(name);
+        let after = &rest[at + APP_NAME.len()..];
+        rest = after.trim_start_matches(|c: char| c.is_ascii_lowercase());
+    }
+    out.push_str(rest);
+    std::borrow::Cow::Owned(out)
+}
+
+/// Hanpan: [`rename`] for a lookup's result: `source` is the English text (or a command id) it was
+/// looked up by, so the About window's strings ([`KEEP_NAME`]) keep the name. A renamed text is
+/// built once per thread and kept (it is a catalog entry or an English UI string, a bounded set),
+/// so drawing it every frame allocates nothing. Past [`MAX_RENAMED`] texts (none of the bundled
+/// catalogs comes near) a new text is shown as it is, and the console says so once.
+fn hosted<'a>(lang: Lang, source: &str, text: &'a str) -> &'a str {
+    if !host_names() || !text.contains(APP_NAME) || KEEP_NAME.contains(&source) || source == "help.about" {
+        return text;
+    }
+    thread_local! {
+        // [other languages, Korean]: renamed text by the text it was made from
+        static RENAMED: std::cell::RefCell<[std::collections::HashMap<Box<str>, &'static str>; 2]> = Default::default();
+        static FULL_NOTED: Cell<bool> = const { Cell::new(false) };
+    }
+    RENAMED.with(|renamed| -> &'a str {
+        let mut renamed = renamed.borrow_mut();
+        let table = &mut renamed[usize::from(lang.code() == "ko")];
+        if let Some(&done) = table.get(text) {
+            return done;
+        }
+        if table.len() >= MAX_RENAMED {
+            if !FULL_NOTED.replace(true) {
+                log::warn!("hanpan: over {MAX_RENAMED} texts name the app; {text:?} and later ones keep the name");
+            }
+            return text;
+        }
+        let done: &'static str = Box::leak(rename(lang, text).into_owned().into_boxed_str());
+        table.insert(text.into(), done);
+        done
+    })
+}
+
+/// Hanpan: the most renamed texts [`hosted`] keeps per thread and language (the catalogs hold
+/// about 25 per language).
+const MAX_RENAMED: usize = 4096;
+
+/// Hanpan: [`rename`] for text that may already be owned (the status line's).
+pub fn rename_cow(lang: Lang, text: std::borrow::Cow<'_, str>) -> std::borrow::Cow<'_, str> {
+    if !host_names() || !text.contains(APP_NAME) {
+        return text;
+    }
+    std::borrow::Cow::Owned(rename(lang, &text).into_owned())
+}
