diff --git a/crates/ui-egui/src/local_fonts.rs b/crates/ui-egui/src/local_fonts.rs
new file mode 100644
index 0000000..d83c5bc
--- /dev/null
+++ b/crates/ui-egui/src/local_fonts.rs
@@ -0,0 +1,206 @@
+//! Hanpan: fonts installed on the user's PC, for the web build in embedded mode (`?embedded=hanpan`).
+//! The font menus show them in their own section, "이 PC의 글꼴". The web shell lists them with the
+//! browser's Local Font Access API (`window.queryLocalFonts()`) the first time a font menu opens,
+//! and reads a family's files when one is picked there; this module is the state between the menus
+//! and the shell. Off (and empty) unless the shell calls [`enable`].
+
+use std::sync::{Mutex, MutexGuard, PoisonError};
+
+/// The section's heading in the font menus.
+pub const HEADING: &str = "이 PC의 글꼴";
+
+/// Where the list of the PC's font families is.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Listing {
+    /// Not asked for yet: the first font menu that opens asks.
+    NotAsked,
+    /// Asked for, not yet taken by the shell ([`take_list_request`]), or being read.
+    Pending,
+    /// The PC's families, sorted, each once.
+    Listed(Vec<String>),
+    /// The browser refused or has no Local Font Access (the reason, for the menu).
+    Failed(String),
+}
+
+/// A family picked in the section.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Load {
+    /// Waiting for the shell, or being read.
+    Loading,
+    /// In the app's fonts: the family names its files registered.
+    Loaded(Vec<String>),
+    Failed(String),
+}
+
+struct State {
+    enabled: bool,
+    listing: Listing,
+    list_requested: bool,
+    /// Families picked, not yet taken by the shell.
+    requested: Vec<String>,
+    loads: Vec<(String, Load)>,
+    /// Bumped on every change, so menus build their rows again.
+    generation: u64,
+}
+
+static STATE: Mutex<State> =
+    Mutex::new(State { enabled: false, listing: Listing::NotAsked, list_requested: false, requested: Vec::new(), loads: Vec::new(), generation: 0 });
+
+fn state() -> MutexGuard<'static, State> {
+    STATE.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+/// The shell turns the section on (embedded mode, in a browser).
+pub fn enable() {
+    let mut s = state();
+    s.enabled = true;
+    s.generation = s.generation.wrapping_add(1);
+}
+
+/// Do the font menus show the section?
+pub fn enabled() -> bool {
+    state().enabled
+}
+
+/// Changes whenever anything here does.
+pub fn generation() -> u64 {
+    state().generation
+}
+
+pub fn listing() -> Listing {
+    state().listing.clone()
+}
+
+/// Asks the shell for the list: once, or again after it failed.
+pub fn ask_list() {
+    let mut s = state();
+    if s.enabled && matches!(s.listing, Listing::NotAsked | Listing::Failed(_)) {
+        s.listing = Listing::Pending;
+        s.list_requested = true;
+        s.generation = s.generation.wrapping_add(1);
+    }
+}
+
+/// For the shell: should it read the list now? True once per [`ask_list`].
+pub fn take_list_request() -> bool {
+    std::mem::take(&mut state().list_requested)
+}
+
+/// For the shell: the families it read, or why it could not.
+pub fn listed(result: Result<Vec<String>, String>) {
+    let mut s = state();
+    s.listing = match result {
+        Ok(mut families) => {
+            families.sort_by_key(|f| f.to_lowercase());
+            families.dedup_by(|a, b| a.eq_ignore_ascii_case(b));
+            Listing::Listed(families)
+        }
+        Err(e) => Listing::Failed(e),
+    };
+    s.generation = s.generation.wrapping_add(1);
+}
+
+/// Asks the shell to load `family`'s files into the app's fonts. Asking again is harmless; a
+/// family that failed is tried again.
+pub fn request(family: &str) {
+    let mut s = state();
+    if !s.enabled {
+        return;
+    }
+    match s.loads.iter().position(|(f, _)| f == family) {
+        Some(i) if !matches!(s.loads[i].1, Load::Failed(_)) => return,
+        Some(i) => s.loads[i].1 = Load::Loading,
+        None => s.loads.push((family.to_string(), Load::Loading)),
+    }
+    s.requested.push(family.to_string());
+    s.generation = s.generation.wrapping_add(1);
+}
+
+/// For the shell: the families to load now.
+pub fn take_requests() -> Vec<String> {
+    std::mem::take(&mut state().requested)
+}
+
+/// For the shell: `family` is loaded (the names its files registered) or failed.
+pub fn finished(family: &str, result: Result<Vec<String>, String>) {
+    let mut s = state();
+    let load = match result {
+        Ok(names) => Load::Loaded(names),
+        Err(e) => Load::Failed(e),
+    };
+    match s.loads.iter_mut().find(|(f, _)| f == family) {
+        Some(entry) => entry.1 = load,
+        None => s.loads.push((family.to_string(), load)),
+    }
+    s.generation = s.generation.wrapping_add(1);
+}
+
+/// Where `family`'s load is, if it was picked.
+pub fn load_of(family: &str) -> Option<Load> {
+    state().loads.iter().find(|(f, _)| f == family).map(|(_, l)| l.clone())
+}
+
+/// The families of the PC to list for `query` (lowercase; empty: all): those the app does not
+/// have already (`known`, compared ignoring case).
+pub fn families_for(query: &str, known: &[String]) -> Vec<String> {
+    let Listing::Listed(all) = listing() else { return Vec::new() };
+    all.into_iter()
+        .filter(|f| query.is_empty() || f.to_lowercase().contains(query))
+        .filter(|f| !known.iter().any(|k| k.eq_ignore_ascii_case(f)))
+        .collect()
+}
+
+/// The line the section shows instead of families, if any, and whether clicking it asks for the
+/// list again.
+pub fn note() -> Option<(String, bool)> {
+    match listing() {
+        Listing::NotAsked => Some(("이 PC의 글꼴 불러오기".into(), true)),
+        Listing::Pending => Some(("이 PC의 글꼴을 읽는 중…".into(), false)),
+        Listing::Listed(_) => None,
+        Listing::Failed(e) => Some((format!("이 PC의 글꼴을 읽지 못했습니다 ({e}). 눌러서 다시 시도"), true)),
+    }
+}
+
+/// What a family's row says after its name while it loads or when it failed.
+pub fn suffix(family: &str) -> Option<String> {
+    match load_of(family)? {
+        Load::Loading => Some("불러오는 중…".into()),
+        Load::Loaded(_) => None,
+        Load::Failed(e) => Some(format!("실패: {e}")),
+    }
+}
+
+/// The page API's `fonts.local` request (`window.<app>.request('fonts.local', params)`), so the
+/// host's AI can use the PC's fonts too. Without `family`: asks for the list once and answers where
+/// it is (`{listing: "pending" | "listed" | "failed", families?, error?}`). With `family`: asks for
+/// that family to load and answers where that is (`{family, status: "loading" | "loaded" |
+/// "failed", names?, error?}`; `names` are the families its files registered, to set text in).
+/// Ask again until the answer is no longer pending or loading.
+pub fn control(params: &serde_json::Value) -> Result<serde_json::Value, String> {
+    use serde_json::json;
+    if !enabled() {
+        return Err("the PC's fonts are only offered in embedded mode (embedded=hanpan)".into());
+    }
+    match params.get("family").and_then(serde_json::Value::as_str) {
+        None => {
+            ask_list();
+            Ok(match listing() {
+                Listing::NotAsked | Listing::Pending => json!({"listing": "pending"}),
+                Listing::Listed(families) => json!({"listing": "listed", "families": families}),
+                Listing::Failed(e) => json!({"listing": "failed", "error": e}),
+            })
+        }
+        Some(family) => {
+            match listing() {
+                Listing::Listed(all) if all.iter().any(|f| f == family) => request(family),
+                Listing::Listed(_) => return Err(format!("no font family {family:?} on this PC")),
+                _ => return Err("the PC's fonts are not listed yet: call fonts.local without a family first".into()),
+            }
+            Ok(match load_of(family) {
+                Some(Load::Loaded(names)) => json!({"family": family, "status": "loaded", "names": names}),
+                Some(Load::Failed(e)) => json!({"family": family, "status": "failed", "error": e}),
+                _ => json!({"family": family, "status": "loading"}),
+            })
+        }
+    }
+}
