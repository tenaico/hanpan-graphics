+                *UI_ARRIVED.lock().unwrap_or_else(PoisonError::into_inner) = Some((family.to_string(), regular, bold));
+            }
+            Err(e) => {
+                log::info!("local fonts: {family} by its PostScript names: {e}; reading the list instead");
+                *UI_FALLBACK.lock().unwrap_or_else(PoisonError::into_inner) = Some(family);
+            }
