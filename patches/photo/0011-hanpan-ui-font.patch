+        // semibold labels draw Hangul in the PC face's Bold
+        let semibold = stack(&ctx, FontFamily::Name("semibold".into()));
+        let at = |name: &str| semibold.iter().position(|n| n == name);
+        assert!(at("pc-hangul:Malgun Gothic:Bold") < at("pc-hangul:Malgun Gothic"), "{semibold:?}");
+        assert!(at("pc-hangul:Malgun Gothic:Bold").is_some(), "{semibold:?}");
+        assert!(!stack(&ctx, FontFamily::Proportional).iter().any(|n| n.ends_with(":Bold")), "regular text does not draw bold");
+        // a rebuild (language change) keeps it
+        crate::theme::install_fonts_with(&ctx, web());
+        draw(&ctx, "File");
+        assert!(stack(&ctx, FontFamily::Proportional).iter().any(|n| n == "pc-hangul:Malgun Gothic"));
+        assert_eq!(crate::theme::ui_hangul_face(&ctx).as_deref(), Some("Malgun Gothic"));
+    }
+
+    /// Permission denied, no such face on the PC, a file that is not a font, or no PC face asked
+    /// for (not Windows or macOS): the stack is today's, and NanumGothic draws Hangul.
+    #[test]
+    fn ui_stack_without_the_pc_face_is_unchanged() {
+        let today = egui::Context::default();
+        crate::theme::install_fonts_with(&today, web());
+        draw(&today, "File");
+        serve_nanum(&today);
+        draw(&today, "File");
+        assert!(ui_face("Malgun Gothic", b"<html>not found</html>".to_vec(), None).is_none(), "an unreadable file is no face");
+        assert!(ui_face("Malgun Gothic", Vec::new(), None).is_none());
+        let ctx = egui::Context::default();
+        crate::theme::set_ui_hangul_face(&ctx, None);
+        crate::theme::install_fonts_with(&ctx, web());
+        draw(&ctx, "File");
+        serve_nanum(&ctx);
+        ctx.set_missing_glyph_policy(egui::MissingGlyphPolicy::Panic);
+        draw(&ctx, "File");
+        draw(&ctx, "파일 한글");
+        for family in [FontFamily::Proportional, FontFamily::Monospace, FontFamily::Name("medium".into()), FontFamily::Name("semibold".into())] {
+            assert_eq!(stack(&ctx, family.clone()), stack(&today, family.clone()), "{family:?}");
+        }
+        assert!(!stack(&ctx, FontFamily::Proportional).iter().any(|n| n.starts_with("pc-hangul:")));
+        assert_eq!(crate::theme::ui_hangul_face(&ctx), None);
+    }
+}
