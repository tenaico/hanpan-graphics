+/// Hanpan: when each step of reading the interface's Hangul face happened, in milliseconds since
+/// the page started (the shell's clock), first time each: `hanpan.status` reports them as
+/// `uiFontSteps` so a release check can tell where the face's time goes.
+static UI_FACE_STEPS: Mutex<Vec<(&'static str, f64)>> = Mutex::new(Vec::new());
+
+/// Hanpan: the shell reached `step` of the interface face at `at_ms` (kept the first time only).
+pub fn ui_face_step(step: &'static str, at_ms: f64) {
+    record_step(&mut UI_FACE_STEPS.lock().unwrap_or_else(PoisonError::into_inner), step, at_ms);
+}
+
+fn record_step(steps: &mut Vec<(&'static str, f64)>, step: &'static str, at_ms: f64) {
+    if !steps.iter().any(|(s, _)| *s == step) {
+        steps.push((step, at_ms));
+    }
+}
+
+/// Hanpan: the steps [`ui_face_step`] recorded, in the order they happened.
+pub fn ui_face_steps() -> Vec<(&'static str, f64)> {
+    UI_FACE_STEPS.lock().unwrap_or_else(PoisonError::into_inner).clone()
+}
