+
+/// Hanpan: with no layer chosen (a Move-tool click on the pasteboard deselects every layer,
+/// #8100), a press with a painting tool is refused with a hint in the interface language, not the
+/// engine's "command `paint.stroke` is not available right now: no active layer" after the stroke.
+#[test]
+fn hanpan_painting_with_no_layer_chosen_asks_for_one() {
+    let ko = crate::i18n::Lang::from_code("ko").expect("ko registered");
+    for tool in [Tool::Brush, Tool::Pencil, Tool::Eraser, Tool::PaintBucket, Tool::CloneStamp] {
+        let (mut app, id) = app(tool);
+        app.session.execute("layer.setProps", json!({"layer": id.0, "visible": true})).unwrap();
+        app.session.execute("select.deselectLayers", json!({})).unwrap();
+        assert_eq!(app.session.active().unwrap().active_layer, None);
+        let n = steps(&app);
+        crate::i18n::with_language(ko, || {
+            tool_event(&mut app, ToolEvent::Down { x: 30.0, y: 30.0, pressure: 1.0 }, egui::Modifiers::NONE);
+        });
+        assert!(app.drag.is_none() && app.live_stroke.is_none(), "{tool:?}: no stroke started");
+        assert!(app.ui.status_error, "{tool:?}");
+        assert_eq!(app.ui.status, "레이어를 먼저 고르세요. 레이어 패널에서 그릴 레이어를 누르세요.", "{tool:?}");
+        tool_event(&mut app, ToolEvent::Up { x: 40.0, y: 40.0 }, egui::Modifiers::NONE);
+        assert_eq!(steps(&app), n, "{tool:?}: nothing painted");
+        assert!(!app.ui.status.contains("not available"), "{tool:?}: {}", app.ui.status);
+        // A layer chosen again, the same press paints.
+        app.session.execute("layer.select", json!({"layer": id.0})).unwrap();
+        app.ui.status.clear();
+        app.ui.status_error = false;
+        tool_event(&mut app, ToolEvent::Down { x: 30.0, y: 30.0, pressure: 1.0 }, egui::Modifiers::NONE);
+        assert!(app.ui.status.is_empty(), "{tool:?}: {}", app.ui.status);
+    }
+}
+
+/// Hanpan: the engine's "no active layer" refusal never reaches the status line as it is, whichever
+/// path set it: the line shows the same hint.
+#[test]
+fn hanpan_the_status_line_says_no_active_layer_in_the_interface_language() {
+    let ko = crate::i18n::Lang::from_code("ko").expect("ko registered");
+    let engine = "command `paint.stroke` is not available right now: no active layer";
+    crate::i18n::with_language(ko, || {
+        assert_eq!(crate::panels::status_bar::shown_status(engine), "레이어를 먼저 고르세요. 레이어 패널에서 그릴 레이어를 누르세요.");
+        assert_eq!(crate::panels::status_bar::shown_status("photo.psd 저장됨"), "photo.psd 저장됨");
+    });
+}
