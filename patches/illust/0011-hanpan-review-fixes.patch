+/// Hanpan: milliseconds since the page started (`performance.now()`), 0 without one.
+pub fn now_ms() -> f64 {
+    web_sys::window()
+        .and_then(|w| Reflect::get(&w, &JsValue::from_str("performance")).ok())
+        .and_then(|p| {
+            let now: Function = Reflect::get(&p, &JsValue::from_str("now")).ok()?.dyn_into().ok()?;
+            now.call0(&p).ok()?.as_f64()
+        })
+        .unwrap_or(0.0)
+}
+
+/// Hanpan: record a step of the interface face now (`hanpan.status`'s `uiFontSteps`).
+pub fn step(name: &'static str) {
+    local_fonts::ui_face_step(name, now_ms());
+}
+
+/// Hanpan: called at the start of every frame: records the first frame, and the first frame after
+/// the face was installed (the pass whose fonts carry it).
+pub fn frame_step() {
+    if !local_fonts::enabled() {
+        return;
+    }
+    let steps = local_fonts::ui_face_steps();
+    let has = |name: &str| steps.iter().any(|(s, _)| *s == name);
+    if !has("firstFrame") {
+        step("firstFrame");
+    } else if has("installed") && !has("appliedFrame") {
+        step("appliedFrame");
+    }
+}
