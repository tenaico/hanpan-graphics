diff --git a/crates/ui-egui/src/theme/hanpan.rs b/crates/ui-egui/src/theme/hanpan.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4b7d25efa54f969a4c5b8b1187b4e8b040107356
--- /dev/null
+++ b/crates/ui-egui/src/theme/hanpan.rs
@@ -0,0 +1,94 @@
+//! Hanpan: the two themes PhotoCraft wears inside Hanpan (`?embedded=hanpan`), so the AI Photo
+//! tab looks like Hanpan's other editors. The colours are the AI Word tab's chrome (Hanpan's
+//! `packages/ui/src/tokens.css` and the Word editor's styles) with the photo accent #A3449E. What
+//! Word has no counterpart for, corners and spacing included, is Pro (Light)'s or Pro (Dark)'s.
+//! Neither theme is listed in `ThemeKind::ALL`, named by `ThemeKind::from_name` or offered by
+//! the engine's theme preferences: only the host page picks them (`crate::embedded`).
+
+use super::{ThemeKind, Tokens};
+use egui::Color32;
+
+const fn hex(rgb: u32) -> Color32 {
+    Color32::from_rgb((rgb >> 16) as u8, (rgb >> 8) as u8, rgb as u8)
+}
+
+/// The photo accent.
+const ACCENT: Color32 = hex(0xa3449e);
+/// The accent on the dark chrome: #A3449E is 2.8:1 on #252525, under WCAG's 3:1 for lines and
+/// icons, so accent marks there are this lighter shade of it (3.4:1 or more on every dark surface).
+const DARK_ACCENT: Color32 = hex(0xb957b4);
+/// Accent-coloured text on the dark panels: 4.5:1 or more on every dark panel surface.
+const DARK_ACCENT_TEXT: Color32 = hex(0xc574c1);
+
+/// The accent at alpha 0x26: selected rows and soft accent fills.
+fn accent_tint() -> Color32 {
+    let [r, g, b, _] = ACCENT.to_array();
+    Color32::from_rgba_unmultiplied(r, g, b, 0x26)
+}
+
+pub(super) fn light() -> Tokens {
+    let canvas = hex(0xe6e6e6);
+    let dock = hex(0xf6f7f9);
+    let text_dim = hex(0x606366);
+    Tokens {
+        kind: ThemeKind::HanpanLight,
+        chrome: hex(0xffffff),
+        canvas,
+        canvas_dot: canvas,
+        dock,
+        card: hex(0xffffff),
+        card_border: hex(0xe3e6ea),
+        field: hex(0xf6f7f9),
+        field_border: hex(0xd9d9d9),
+        hover: hex(0xf5f5f5),
+        pressed: hex(0xe8eaee),
+        text: hex(0x242424),
+        text_dim,
+        text_faint: hex(0x909499),
+        icon: text_dim,
+        accent: ACCENT,
+        accent_soft: accent_tint(),
+        accent_border: ACCENT,
+        accent_text: ACCENT,
+        separator: hex(0xefefef),
+        primary_bg: ACCENT,
+        primary_text: Color32::WHITE,
+        tab_strip: dock,
+        row_selected: accent_tint(),
+        ..Tokens::for_kind(ThemeKind::ProLight)
+    }
+}
+
+pub(super) fn dark() -> Tokens {
+    let canvas = hex(0x2b2b2b);
+    let dock = hex(0x252525);
+    let text_dim = hex(0xa0a0a0);
+    Tokens {
+        kind: ThemeKind::HanpanDark,
+        chrome: hex(0x252525),
+        canvas,
+        canvas_dot: canvas,
+        dock,
+        card: hex(0x1e1e1e),
+        card_border: hex(0x3a3a3a),
+        field: hex(0x2a2a2a),
+        field_border: hex(0x555555),
+        hover: hex(0x333333),
+        pressed: hex(0x444444),
+        text: hex(0xe4e4e4),
+        text_dim,
+        text_faint: hex(0xa0a0a0),
+        icon: text_dim,
+        accent: DARK_ACCENT,
+        accent_soft: accent_tint(),
+        accent_border: DARK_ACCENT,
+        accent_text: DARK_ACCENT_TEXT,
+        separator: hex(0x3a3a3a),
+        // white button text keeps 5.4:1 on the photo accent itself
+        primary_bg: ACCENT,
+        primary_text: Color32::WHITE,
+        tab_strip: dock,
+        row_selected: accent_tint(),
+        ..Tokens::for_kind(ThemeKind::Pro)
+    }
+}
diff --git a/crates/ui-egui/src/theme/tests.rs b/crates/ui-egui/src/theme/tests.rs
index d869649853d6af4515278dc522d0c3e62ecde875..be511d5e8adab37a8ed713bd2c84c1fb560da08e 100644
--- a/crates/ui-egui/src/theme/tests.rs
+++ b/crates/ui-egui/src/theme/tests.rs
@@ -362,3 +362,96 @@ fn breeze_themes_parse_and_meet_text_contrast() {
         assert!(contrast(t.caption_close_text, t.caption_close) >= 4.5, "{kind:?}: close button glyph");
     }
 }
+
+/// Hanpan: a `0xrrggbb` value as an opaque colour.
+fn hex(rgb: u32) -> Color32 {
+    Color32::from_rgb((rgb >> 16) as u8, (rgb >> 8) as u8, rgb as u8)
+}
+
+/// Hanpan: the light theme is the AI Word tab's chrome (Hanpan spec 5.1), with the photo accent.
+#[test]
+fn hanpan_light_tokens_match_word() {
+    let t = Tokens::for_kind(ThemeKind::HanpanLight);
+    assert_eq!(t.chrome, hex(0xffffff));
+    assert_eq!(t.canvas, hex(0xe6e6e6));
+    assert_eq!(t.card, hex(0xffffff));
+    assert_eq!(t.card_border, hex(0xe3e6ea));
+    assert_eq!(t.text, hex(0x242424));
+    assert_eq!(t.text_dim, hex(0x606366));
+    assert_eq!(t.accent, hex(0xa3449e));
+    assert_eq!(t.separator, hex(0xefefef));
+    assert_eq!(t.dock, hex(0xf6f7f9));
+    assert_eq!(t.field, hex(0xf6f7f9));
+    assert_eq!(t.field_border, hex(0xd9d9d9));
+    assert_eq!(t.hover, hex(0xf5f5f5));
+    assert_eq!(t.pressed, hex(0xe8eaee));
+    assert_eq!(t.text_faint, hex(0x909499));
+    assert_eq!(t.icon, t.text_dim);
+    assert_eq!(t.accent_soft, Color32::from_rgba_unmultiplied(0xa3, 0x44, 0x9e, 0x26));
+    assert_eq!(t.row_selected, t.accent_soft);
+    assert_eq!((t.accent_border, t.accent_text, t.primary_bg), (t.accent, t.accent, t.accent));
+    assert_eq!(t.primary_text, Color32::WHITE);
+    assert_eq!((t.tab_strip, t.canvas_dot), (t.dock, t.canvas));
+    // the rest is Pro (Light)'s, corners and spacing included
+    let base = Tokens::for_kind(ThemeKind::ProLight);
+    assert_eq!((t.radius_sm, t.radius, t.radius_lg, t.pro, t.bevel), (base.radius_sm, base.radius, base.radius_lg, base.pro, base.bevel));
+    assert_eq!((t.shadow, t.danger, t.warning), (base.shadow, base.danger, base.warning));
+    assert_eq!(t.kind, ThemeKind::HanpanLight);
+}
+
+/// Hanpan: the dark theme is the AI Word tab's dark chrome.
+#[test]
+fn hanpan_dark_tokens_match_word() {
+    let t = Tokens::for_kind(ThemeKind::HanpanDark);
+    assert_eq!(t.chrome, hex(0x252525));
+    assert_eq!(t.canvas, hex(0x2b2b2b));
+    assert_eq!(t.card, hex(0x1e1e1e));
+    assert_eq!(t.card_border, hex(0x3a3a3a));
+    assert_eq!(t.separator, hex(0x3a3a3a));
+    assert_eq!(t.text, hex(0xe4e4e4));
+    assert_eq!(t.text_dim, hex(0xa0a0a0));
+    assert_eq!(t.text_faint, hex(0xa0a0a0));
+    assert_eq!(t.dock, hex(0x252525));
+    assert_eq!(t.field, hex(0x2a2a2a));
+    assert_eq!(t.field_border, hex(0x555555));
+    assert_eq!(t.hover, hex(0x333333));
+    assert_eq!(t.pressed, hex(0x444444));
+    assert_eq!(t.icon, t.text_dim);
+    assert_eq!((t.tab_strip, t.canvas_dot), (t.dock, t.canvas));
+    // buttons keep the photo accent behind their white text
+    assert_eq!(t.primary_bg, hex(0xa3449e));
+    assert_eq!(t.primary_text, Color32::WHITE);
+    let base = Tokens::for_kind(ThemeKind::Pro);
+    assert_eq!((t.radius_sm, t.radius, t.radius_lg, t.pro, t.bevel), (base.radius_sm, base.radius, base.radius_lg, base.pro, base.bevel));
+    assert!(ThemeKind::HanpanDark.is_dark() && !ThemeKind::HanpanLight.is_dark());
+    assert_eq!(t.kind, ThemeKind::HanpanDark);
+}
+
+/// Hanpan: #A3449E is only 2.8:1 on the dark chrome, so the dark theme draws accent marks a
+/// lighter shade of it (3:1 for lines and icons, 4.5:1 for accent text) and keeps #A3449E where
+/// white text sits on it.
+#[test]
+fn hanpan_accent_reads_on_both_themes() {
+    for kind in [ThemeKind::HanpanLight, ThemeKind::HanpanDark] {
+        let t = Tokens::for_kind(kind);
+        for surface in [t.chrome, t.card, t.dock, t.field, t.canvas] {
+            assert!(contrast(t.accent, surface) >= 3.0, "{kind:?}: accent on {surface:?} is {:.2}", contrast(t.accent, surface));
+        }
+        // accent text sits on the panels, not on the pasteboard
+        for surface in [t.chrome, t.card, t.dock, t.field] {
+            assert!(contrast(t.accent_text, surface) >= 4.5, "{kind:?}: accent text on {surface:?} is {:.2}", contrast(t.accent_text, surface));
+        }
+        assert!(contrast(t.primary_text, t.primary_bg) >= 4.5, "{kind:?}: button text");
+    }
+}
+
+/// Hanpan: the two themes are the host's alone; no theme list, name or menu offers them.
+#[test]
+fn hanpan_themes_are_not_listed_or_named() {
+    for kind in [ThemeKind::HanpanLight, ThemeKind::HanpanDark] {
+        assert!(!ThemeKind::ALL.contains(&kind));
+        assert!(kind.is_pro() && kind.is_hanpan());
+        assert_eq!(ThemeKind::from_name(kind.id()), None);
+    }
+    assert!(ThemeKind::ALL.iter().all(|k| !k.is_hanpan()));
+}
