+/// Hanpan (final review): whether the page (`location.search`) wants the interface's Hangul in
+/// the PC's own face: embedded and the interface is Korean (`lang=ko`, which Hanpan's address
+/// always carries and the app's language follows). Other languages keep the served fonts in the
+/// order their script asks for (Japanese and Chinese draw Han in their own face), and do not read
+/// the PC face or wait for it.
+pub fn ui_face_wanted(query: &str) -> bool {
+    crate::embedded::requested(query)
+        && query.trim_start_matches('?').split('&').filter_map(|kv| kv.strip_prefix("lang=")).any(|lang| {
+            let lang = lang.to_ascii_lowercase();
+            lang == "ko" || lang.starts_with("ko-")
+        })
+}
+
+/// Hanpan (final review): the next pause (ms) while the first frame waits for the interface face,
+/// or `None` to stop: once `until_ms` (page time) has passed, or once the pauses so far
+/// (`waited_ms`) add up to `budget_ms`, the cap that ends the wait even when the page clock does
+/// not move (`performance.now()` missing reads 0).
+pub fn ui_face_pause(now_ms: f64, until_ms: f64, waited_ms: f64, budget_ms: f64) -> Option<i32> {
+    if !(now_ms < until_ms && waited_ms < budget_ms) {
+        return None;
+    }
+    Some((until_ms - now_ms).min(budget_ms - waited_ms).clamp(1.0, 16.0) as i32)
+}
