+pub fn default_name(lang: Lang, name: &str) -> std::borrow::Cow<'_, str> {
+    use std::borrow::Cow;
+    let number = |rest: &str| !rest.is_empty() && rest.bytes().all(|b| b.is_ascii_digit());
+    if let Some(n) = name.strip_prefix("Untitled-").filter(|n| number(n)) {
+        return Cow::Owned(format!("{}-{n}", tr(lang, "Untitled")));
+    }
+    for (prefix, template) in [("Layer ", "Layer {number}"), ("Artboard ", "Artboard {number}")] {
+        if let Some(n) = name.strip_prefix(prefix).filter(|n| number(n)) {
+            return Cow::Owned(fmt(tr(lang, template), &[("number", n)]));
+        }
+    }
+    Cow::Borrowed(name)
+}
