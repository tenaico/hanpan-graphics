+static UI_FALLBACK: Mutex<Option<&'static str>> = Mutex::new(None);
+
+/// Hanpan: start reading the interface's Hangul face `family` now, before the app exists:
+/// `queryLocalFonts({postscriptNames})` gives only its Regular and Bold, so no list of every font
+/// is read first (that list also comes with the first font menu). The Regular is read before the
+/// Bold; both go to the shell together ([`take_ui_face`]). When the PC does not give the Regular
+/// that way, the face is asked for through the list as before.
+pub fn start_ui_face(family: &'static str) {
+    step("asked");
+    wasm_bindgen_futures::spawn_local(async move {
+        match read_ui_face(family).await {
+            Ok(files) => {
+                step("handed");
+                log::info!("local fonts: {family} for the interface ({} bytes, bold: {})", files.regular.len(), files.bold_names.is_some());
+                *UI_ARRIVED.lock().unwrap_or_else(PoisonError::into_inner) = Some(files);
+            }
+            Err(e) => {
+                log::info!("local fonts: {family} by its PostScript names: {e}; reading the list instead");
+                *UI_FALLBACK.lock().unwrap_or_else(PoisonError::into_inner) = Some(family);
+            }
+        }
+    });
+}
+
+/// Hanpan: `family`'s Regular and Bold entries found by PostScript name, as [`load_ui`] gives them.
+async fn read_ui_face(family: &str) -> Result<PcFaceFiles, String> {
+    let (regular_name, bold_name) = local_fonts::ui_face_postscript(family).ok_or("no PostScript names known")?;
+    let window = web_sys::window().ok_or("no window")?;
+    let query: Function = Reflect::get(&window, &JsValue::from_str("queryLocalFonts")).map_err(js)?.dyn_into().map_err(|_| "no Local Font Access")?;
+    let options = js_sys::Object::new();
+    let names = Array::of2(&JsValue::from_str(regular_name), &JsValue::from_str(bold_name));
+    Reflect::set(&options, &JsValue::from_str("postscriptNames"), &names).map_err(js)?;
+    step("listStart");
+    let promise: Promise = query.call1(&window, &options).map_err(js)?.dyn_into().map_err(js)?;
+    let fonts = Array::from(&JsFuture::from(promise).await.map_err(js)?);
+    step("listed");
+    let text = |face: &JsValue, key: &str| Reflect::get(face, &JsValue::from_str(key)).ok().and_then(|s| s.as_string()).unwrap_or_default();
+    let names = |face: &JsValue| ListedFace { postscript: text(face, "postscriptName"), full_name: text(face, "fullName") };
+    let named = |name: &str| fonts.iter().find(|f| text(f, "postscriptName") == name);
+    let regular = named(regular_name).ok_or_else(|| format!("no {regular_name} on this PC"))?;
+    step("readStart");
+    let (regular_names, regular_bytes) = (names(&regular), bytes_of(&regular).await?);
+    step("regularRead");
+    let (mut bold, mut bold_names) = (None, None);
+    if let Some(face) = named(bold_name) {
+        match bytes_of(&face).await {
+            Ok(bytes) => {
+                bold_names = Some(names(&face));
+                if bytes.len() != regular_bytes.len() || fingerprint(&bytes) != fingerprint(&regular_bytes) {
+                    bold = Some(bytes);
+                }
+            }
+            Err(e) => log::warn!("local fonts: {family} Bold: {e}"),
+        }
+    }
+    step("boldRead");
+    Ok(PcFaceFiles { family: family.to_string(), regular: regular_bytes, regular_names, bold, bold_names })
+}
