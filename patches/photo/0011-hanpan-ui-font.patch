+/// Hanpan: the egui font name of the PC's Hangul face is this and its family (the Bold one ends
+/// in `:Bold`).
+const PC_HANGUL_PREFIX: &str = "pc-hangul:";
+
+/// Hanpan: the PC's own Hangul face for the interface (embedded mode), built by
+/// `local_fonts::ui_face` from the files the browser read.
+#[derive(Clone)]
+pub struct UiHangulFace {
+    pub(crate) family: String,
+    pub(crate) regular: Arc<FontData>,
+    pub(crate) bold: Option<Arc<FontData>>,
+}
+
+fn ui_hangul_face_id() -> egui::Id {
+    egui::Id::unique("hanpan-ui-hangul-face")
+}
+
+fn ui_hangul_face_data(ctx: &egui::Context) -> Option<UiHangulFace> {
+    ctx.data(|d| d.get_temp::<Option<UiHangulFace>>(ui_hangul_face_id())).flatten()
+}
+
+/// Hanpan: the face [`install_fonts`] puts in the interface's stack for Hangul from now on
+/// (`None`: none, NanumGothic draws it). Takes effect at the next [`install_fonts`].
+pub fn set_ui_hangul_face(ctx: &egui::Context, face: Option<UiHangulFace>) {
+    ctx.data_mut(|d| d.insert_temp(ui_hangul_face_id(), face));
+}
+
+/// Hanpan: the family of the PC face [`install_fonts`] last put in the interface's font stack, if
+/// it did (read without the context's fonts, which do not exist before the first pass).
+pub fn ui_hangul_face(ctx: &egui::Context) -> Option<String> {
+    ctx.data(|d| d.get_temp::<Option<String>>(ui_hangul_face_id().with("installed"))).flatten()
+}
+
 /// Has [`install_fonts`]'s stack reached the active fonts? Before that (the first pass, when
 /// the desktop app installs fonts and loads preferences in the same frame) the active fonts
 /// are egui's defaults, and rescaling a copy of those would overwrite the queued stack.
