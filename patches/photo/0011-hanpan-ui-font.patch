+pub fn install_ui_face(ctx: &egui::Context, family: &str, regular: Vec<u8>, bold: Option<Vec<u8>>) -> bool {
+    let Some(face) = ui_face(family, regular, bold) else {
+        log::warn!("local fonts: {family} is not a readable font; the interface keeps NanumGothic");
+        return false;
+    };
+    crate::theme::set_ui_hangul_face(ctx, Some(face));
+    crate::theme::install_fonts(ctx);
+    ctx.request_repaint();
+    true
+}
