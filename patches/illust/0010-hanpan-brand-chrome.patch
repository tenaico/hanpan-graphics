diff --git a/crates/ui-egui/src/i18n/host_name_tests.rs b/crates/ui-egui/src/i18n/host_name_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..56dc463acd7df9f96f3add8394d181e446c78fdc
--- /dev/null
+++ b/crates/ui-egui/src/i18n/host_name_tests.rs
@@ -0,0 +1,272 @@
+//! Hanpan: embedded mode calls the app by Hanpan's name for it ("AI 일러스트" in Korean, "AI
+//! Illustration" in every other language) wherever the UI's text names it, except the About
+//! window; the names in user data (file names, paths, layer names) stay as they are.
+
+use super::catalog::parse_entries;
+use super::*;
+
+/// The languages Hanpan opens the AI Illustration tab in.
+const HANPAN_LANGS: [&str; 14] = ["ko", "en", "ja", "fr", "de", "es", "id", "ru", "it", "pl", "cs", "nl", "vi", "pt-br"];
+
+fn lang(code: &str) -> Lang {
+    Lang::from_code(code).unwrap_or_else(|| panic!("{code} registered"))
+}
+
+fn source(code: &str) -> &'static str {
+    LANGUAGES.iter().find(|i| i.code == code).map_or("", |i| i.source)
+}
+
+/// Run `f` with Hanpan's names on, as an embedded frame does, and turn them off again.
+fn hosted<R>(f: impl FnOnce() -> R) -> R {
+    set_host_names(true);
+    let out = f();
+    set_host_names(false);
+    out
+}
+
+fn names_the_app(s: &str) -> bool {
+    s.contains(APP_NAME)
+}
+
+/// A message source with each `{name}` placeholder filled with `value`.
+fn filled(src: &str, value: &str) -> String {
+    let mut out = String::new();
+    let mut rest = src;
+    while let Some(open) = rest.find('{') {
+        out.push_str(&rest[..open]);
+        match rest[open..].find('}') {
+            Some(close) => {
+                out.push_str(value);
+                rest = &rest[open + close + 1..];
+            }
+            None => {
+                out.push_str(&rest[open..]);
+                rest = "";
+            }
+        }
+    }
+    out.push_str(rest);
+    out
+}
+
+/// Every catalog entry that names the app, in every language Hanpan opens illust in, comes out
+/// without the name: plain, contextual (and `t_name`), command-id, plural, `@msg` and
+/// `@msgplural` entries, and the English source column as the English UI shows it. Only the
+/// About window's own strings keep it.
+#[test]
+fn embedded_text_never_names_the_app_except_about() {
+    let mut checked = 0usize;
+    let mut sources = std::collections::BTreeSet::new();
+    hosted(|| {
+        for code in HANPAN_LANGS {
+            let l = lang(code);
+            set_current(l);
+            for (ctx, src, tr_text) in parse_entries(source(code)).0 {
+                sources.insert((ctx.clone(), src.clone()));
+                if !names_the_app(&tr_text) && !names_the_app(&src) {
+                    continue;
+                }
+                let kept = KEEP_NAME.contains(&src.as_str());
+                let shown: Vec<String> = match ctx.as_str() {
+                    "" => vec![tr(l, &src).to_string()],
+                    "@id" => vec![tr_id(l, &src, "x").to_string()],
+                    "@plural" => {
+                        let (one, other) = src.split_once('|').expect("one|other");
+                        [0, 1, 2, 3, 5, 11, 21, 22, 100].iter().map(|n| trn(l, *n, one, other)).collect()
+                    }
+                    "@msg" => vec![message(l, &src), message(l, &filled(&src, "7")), msg(&filled(&src, "x"))],
+                    "@msgplural" => src.split('|').flat_map(|form| [1, 2, 5].map(|n| message(l, &filled(form, &n.to_string())))).collect(),
+                    _ => vec![tr_ctx(l, &ctx, &src).to_string(), t_name(&ctx, &src).to_string()],
+                };
+                for shown in shown {
+                    if kept {
+                        assert_eq!(shown, tr_text, "{code}: the About window keeps the name: {src:?}");
+                    } else {
+                        assert!(!names_the_app(&shown), "{code} {ctx:?} {src:?}: {shown:?}");
+                    }
+                    checked += 1;
+                }
+            }
+        }
+        // The English source column, as the English UI (and any language without the entry) shows it.
+        set_current(Lang::EN);
+        for (ctx, src) in &sources {
+            if !names_the_app(src) {
+                continue;
+            }
+            let shown: Vec<String> = match ctx.as_str() {
+                "" => vec![tr(Lang::EN, src).to_string()],
+                "@id" => continue,
+                "@plural" => {
+                    let (one, other) = src.split_once('|').expect("one|other");
+                    [1, 2].iter().map(|n| trn(Lang::EN, *n, one, other)).collect()
+                }
+                "@msg" => vec![message(Lang::EN, src), message(Lang::EN, &filled(src, "7")), msg(&filled(src, "x"))],
+                "@msgplural" => src.split('|').map(|form| message(Lang::EN, &filled(form, "3"))).collect(),
+                _ => vec![tr_ctx(Lang::EN, ctx, src).to_string()],
+            };
+            for shown in shown {
+                if KEEP_NAME.contains(&src.as_str()) {
+                    assert_eq!(&shown, src);
+                } else {
+                    assert!(!names_the_app(&shown), "en {ctx:?} {src:?}: {shown:?}");
+                }
+                checked += 1;
+            }
+        }
+        // The engine's own messages that name the app and have no catalog row.
+        for code in HANPAN_LANGS {
+            set_current(lang(code));
+            for src in ENGINE_MESSAGES {
+                for shown in [message(lang(code), src), message(lang(code), &filled(src, "7"))] {
+                    assert!(!names_the_app(&shown), "{code} engine {src:?}: {shown:?}");
+                    checked += 1;
+                }
+            }
+        }
+        set_current(Lang::EN);
+    });
+    assert!(checked > 14 * 40 * 2, "only {checked} texts name the app: the catalogs moved?");
+}
+
+/// Korean reads 일러스트 with the particles the catalogs already put after the name (가, 를, 는,
+/// 에서, 의 suit a final vowel), and other languages read "AI Illustration".
+#[test]
+fn hanpan_names_read_naturally() {
+    let ko = lang("ko");
+    hosted(|| {
+        assert_eq!(tr(ko, "Quit VectorCraft"), "AI 일러스트 종료");
+        assert_eq!(tr(ko, "Applies the next time VectorCraft starts."), "다음에 AI 일러스트를 시작할 때 적용됩니다.");
+        assert_eq!(tr(ko, "VectorCraft read this script without running it."), "AI 일러스트가 이 스크립트를 실행하지 않고 읽었습니다.");
+        assert_eq!(tr(ko, "In VectorCraft"), "AI 일러스트에서");
+        assert_eq!(message(ko, "VectorCraft doesn't search other apps' or the system's folders: /x"), "AI 일러스트는 다른 앱이나 시스템의 폴더를 검색하지 않습니다: /x");
+        assert_eq!(tr_ctx(ko, "file-filter", "VectorCraft Template"), "AI 일러스트 템플릿");
+        assert_eq!(tr(Lang::EN, "Quit VectorCraft"), "Quit AI Illustration");
+        assert_eq!(tr(lang("fr"), "Quit VectorCraft"), "Quitter AI Illustration");
+        assert_eq!(message(Lang::EN, "VectorCraft failed to start: no GPU"), "AI Illustration failed to start: no GPU");
+        // A case ending stuck to the name goes with it: "AI Illustration" is not declined.
+        assert_eq!(rename(lang("cs"), "ve VectorCraftu.").as_ref(), "ve AI Illustration.");
+        // The About window keeps the original name.
+        assert_eq!(tr(ko, "About VectorCraft"), "VectorCraft 정보");
+        assert_eq!(tr_id(ko, "help.about", "About VectorCraft"), "VectorCraft 정보");
+        assert_eq!(tr(Lang::EN, "About VectorCraft"), "About VectorCraft");
+        // Lower-case identifiers (command lines, file names) are not the name shown to people.
+        assert_eq!(rename(Lang::EN, "the desktop app and vectorcraft-cli set it").as_ref(), "the desktop app and vectorcraft-cli set it");
+    });
+}
+
+/// The name in user data a message carries (a file's name or path, a font's) stays: only the
+/// message's own words change.
+#[test]
+fn user_data_in_messages_keeps_its_name() {
+    let ko = lang("ko");
+    hosted(|| {
+        // English has no catalog: the message is split by the English templates all the same.
+        assert_eq!(
+            message(Lang::EN, "Couldn't open VectorCraft Poster.vectorcraft: not a VectorCraft file: format is `VectorCraft`"),
+            "Couldn't open VectorCraft Poster.vectorcraft: not an AI Illustration file: format is `VectorCraft`"
+        );
+        assert_eq!(message(Lang::EN, "`a.svg` belongs to a VectorCraft that is running"), "`a.svg` belongs to an AI Illustration that is running");
+        assert_eq!(
+            message(ko, "Couldn't open VectorCraft Poster.vectorcraft: not a VectorCraft file: format is `VectorCraft`"),
+            "VectorCraft Poster.vectorcraft을(를) 열 수 없습니다: AI 일러스트 파일이 아닙니다: format is `VectorCraft`"
+        );
+        assert_eq!(
+            message(Lang::EN, "VectorCraft doesn't search the Shared or Public folder in Users: /Users/Shared/VectorCraft"),
+            "AI Illustration doesn't search the Shared or Public folder in Users: /Users/Shared/VectorCraft"
+        );
+        // A template the code fills in itself, then translates: only the template is renamed.
+        let typed = fmt(tr(Lang::EN, "The name in the save panel was “{typed}”; VectorCraft added the file type's extension. Replacing the file overwrites its contents."), &[("typed", "VectorCraft")]);
+        assert_eq!(typed, "The name in the save panel was “VectorCraft”; AI Illustration added the file type's extension. Replacing the file overwrites its contents.");
+        let folder = fmt(tr(ko, "VectorCraft copies the fonts to {folder}."), &[("folder", "C:\\VectorCraft\\Fonts")]);
+        assert_eq!(folder, "AI 일러스트가 글꼴을 C:\\VectorCraft\\Fonts에 복사합니다.");
+        // An engine message with no template anywhere: its own words lose the name, a path, a
+        // quoted name or a file name in it does not.
+        assert_eq!(
+            message(Lang::EN, "Lock Workspace is not available in VectorCraft"),
+            "Lock Workspace is not available in AI Illustration"
+        );
+        assert_eq!(
+            message(Lang::EN, "VectorCraft stopped reading /art/VectorCraft/a.svg, `VectorCraft` and VectorCraft.svg"),
+            "AI Illustration stopped reading /art/VectorCraft/a.svg, `VectorCraft` and VectorCraft.svg"
+        );
+        // A name the user gave something is not a catalog row: `t_name` leaves it.
+        set_current(ko);
+        assert_eq!(t_name("swatch", "VectorCraft Green"), "VectorCraft Green");
+        set_current(Lang::EN);
+    });
+}
+
+/// The same text looked up again is the same interned string: no allocation per frame.
+#[test]
+fn renamed_text_is_interned_once() {
+    let ko = lang("ko");
+    hosted(|| {
+        let a = tr(ko, "Quit VectorCraft");
+        let b = tr(ko, "Quit VectorCraft");
+        assert!(std::ptr::eq(a, b), "the second lookup reuses the first string");
+        assert_eq!(tr(Lang::EN, "Quit VectorCraft"), "Quit AI Illustration", "Korean and other languages are interned apart");
+    });
+}
+
+/// Past the interning limit a text still never shows the name: it is cut to a part without it.
+#[test]
+fn past_the_interning_limit_the_name_stays_hidden() {
+    hosted(|| {
+        set_rename_limit(1);
+        assert_eq!(tr(Lang::EN, "Quit VectorCraft"), "Quit AI Illustration");
+        let past = tr(Lang::EN, "Hide VectorCraft");
+        assert!(!names_the_app(past), "{past:?}");
+        assert_eq!(past, "Hide");
+        assert_eq!(tr(Lang::EN, "VectorCraft Help…"), "Help…");
+        assert_eq!(tr(Lang::EN, "VectorCraft"), "");
+        set_rename_limit(MAX_RENAMED);
+    });
+}
+
+/// Outside Hanpan every string keeps the name, exactly as before.
+#[test]
+fn not_embedded_keeps_the_brand() {
+    let ko = lang("ko");
+    assert!(!host_names());
+    assert_eq!(tr(ko, "Quit VectorCraft"), "VectorCraft 종료");
+    assert_eq!(tr(Lang::EN, "Quit VectorCraft"), "Quit VectorCraft");
+    assert_eq!(tr_ctx(lang("de"), "file-filter", "VectorCraft Template"), "VectorCraft-Vorlage");
+    assert_eq!(message(Lang::EN, "VectorCraft failed to start: no GPU"), "VectorCraft failed to start: no GPU");
+    assert_eq!(message(ko, "not a VectorCraft file: x"), "VectorCraft 파일이 아닙니다: x");
+    assert_eq!(msg("Lock Workspace is not available in VectorCraft"), "Lock Workspace is not available in VectorCraft");
+    assert_eq!(rename(Lang::EN, "VectorCraft").as_ref(), "VectorCraft");
+    // `msg` remembers its last answer: switching Hanpan's names on and off does not reuse it.
+    let named = "Lock Workspace is not available in VectorCraft";
+    assert_eq!(hosted(|| msg(named)), "Lock Workspace is not available in AI Illustration");
+    assert_eq!(msg(named), named);
+}
+
+/// The Home screen's title inside Hanpan, in the languages Hanpan opens illust in.
+#[test]
+fn home_title_is_translated() {
+    const TITLE: &str = "Create a new drawing or open a file.";
+    assert_eq!(tr(lang("ko"), TITLE), "새 그림을 만들거나 파일을 여세요.");
+    assert_eq!(tr(lang("vi"), TITLE), "Tạo bản vẽ mới hoặc mở một tệp.");
+    for code in HANPAN_LANGS.iter().filter(|c| **c != "en") {
+        assert!(has(lang(code), TITLE), "{code}");
+    }
+}
+
+/// Fix round 1: the app's own built-in names shown as they are (a preset, a colour profile, a
+/// format such as the Links panel's "VectorCraft") read without the name inside Hanpan only.
+#[test]
+fn builtin_names_read_without_the_name_inside_hanpan_only() {
+    let ko = lang("ko");
+    assert_eq!(builtin_shown(Lang::EN, "VectorCraft"), "VectorCraft");
+    assert_eq!(builtin_shown(ko, "VectorCraft Default"), "VectorCraft Default", "outside Hanpan exactly as before");
+    assert!(!hosted_builtin_profile(vectorcraft_color::cms::GENERIC_CMYK));
+    hosted(|| {
+        assert_eq!(builtin_shown(Lang::EN, "VectorCraft"), "AI Illustration");
+        assert_eq!(builtin_shown(Lang::EN, "VectorCraft Default"), "AI Illustration Default");
+        assert!(!names_the_app(builtin_shown(ko, "VectorCraft Default")));
+        assert!(!names_the_app(builtin_shown(ko, vectorcraft_color::cms::GENERIC_CMYK)));
+        assert!(hosted_builtin_profile(vectorcraft_color::cms::GENERIC_CMYK));
+        assert!(!hosted_builtin_profile("My VectorCraft Profile"), "a profile the user added is not built in");
+    });
+}
