+        assert!(app.run("window.brightness", json!({"brightness": "light"})).is_err());
+        // `ui.set {brightness}` is ignored; its other fields still apply
+        let reply = call(&mut app, &ctx, "ui.set", json!({"brightness": "light", "status": "hello"}));
+        assert_eq!(reply["ok"], true, "{reply}");
+        assert_eq!(app.ui.status, "hello");
+        assert_eq!(app.session.prefs.ui_brightness, saved, "the saved brightness is left alone");
+        crate::prefs_dialog::apply_runtime(&mut app, &ctx);
+        assert_eq!(look(&Tokens::get(&ctx)), hanpan(true));
+        // preferences set by any path lose to the host's theme
+        app.run("prefs.set", json!({"values": {"uiBrightness": "light", "uiColorScheme": "classic"}})).unwrap();
+        crate::prefs_dialog::apply_runtime(&mut app, &ctx);
+        assert_eq!(look(&Tokens::get(&ctx)), hanpan(true));
+        crate::prefs_dialog::open(&mut app, Some("User Interface"));
+        app.ui.dialog.as_mut().unwrap().fields.insert("uiBrightness".into(), json!("mediumLight"));
+        crate::prefs_dialog::confirm(&mut app).unwrap();
+        crate::prefs_dialog::apply_runtime(&mut app, &ctx);
+        assert_eq!(look(&Tokens::get(&ctx)), hanpan(true));
+    }
+}
