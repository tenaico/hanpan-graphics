+/// Hanpan: draw the UI text with Hanpan's name for the app (`true` in embedded mode; the frame
+/// sets it from `Services::embedded`, next to the language).
+pub fn set_host_names(on: bool) {
+    host_flag().store(on, Ordering::Relaxed);
+}
+
+/// Hanpan: is the UI text drawn with Hanpan's name for the app?
+pub fn host_names() -> bool {
+    host_flag().load(Ordering::Relaxed)
+}
+
+/// Hanpan: what Hanpan calls the app in `lang`: "AI 일러스트" in Korean, "AI Illustration" in every
+/// other language (Hanpan's own UI uses the English name outside Korean). The catalogs' Korean
+/// particles after the name (가, 를, 는, 에서, 의) already suit 일러스트's final vowel.
+pub fn host_app_name(lang: Lang) -> &'static str {
+    if lang.code() == "ko" { "AI 일러스트" } else { "AI Illustration" }
+}
+
+/// Hanpan: `text`, a translation or English UI text in `lang`, with [`APP_NAME`] as Hanpan calls
+/// the app when [`host_names`] is on (otherwise, or without the name, `text` itself).
+pub fn rename(lang: Lang, text: &str) -> std::borrow::Cow<'_, str> {
+    rename_text(lang, text, lang == Lang::EN)
+}
+
+/// [`rename`] for text that is English (`english`) or written in `lang`. A case ending stuck to the
+/// name (Czech "VectorCraftu") goes with it: "AI Illustration" is not declined. English "a
+/// VectorCraft" reads "an AI Illustration". Lower-case identifiers such as `vectorcraft-cli` are not
+/// the name shown to people and stay. Only for the app's own text, never for a value in it.
+fn rename_text<'t>(lang: Lang, text: &'t str, english: bool) -> std::borrow::Cow<'t, str> {
+    if !host_names() || !text.contains(APP_NAME) {
+        return std::borrow::Cow::Borrowed(text);
+    }
+    let name = host_app_name(lang);
+    let mut out = String::with_capacity(text.len() + 8);
+    let mut rest = text;
+    while let Some(at) = rest.find(APP_NAME) {
+        push_before_name(&mut out, &rest[..at], english);
+        out.push_str(name);
+        rest = rest[at + APP_NAME.len()..].trim_start_matches(|c: char| c.is_ascii_lowercase());
+    }
+    out.push_str(rest);
+    std::borrow::Cow::Owned(out)
+}
+
+/// The text before a renamed name, with an English "a" before it made "an" (both of Hanpan's
+/// names start with "AI").
+fn push_before_name(out: &mut String, before: &str, english: bool) {
+    let article = before.strip_suffix("a ").filter(|lead| english && lead.chars().last().is_none_or(|c| !c.is_alphanumeric()));
+    match article {
+        Some(lead) => {
+            out.push_str(lead);
+            out.push_str("an ");
+        }
+        None => out.push_str(before),
+    }
+}
+
+/// Hanpan: an English message no template knows (the whole of it, not a value in a known one)
+/// with the name renamed where it is the message's own word: not in a path or a file name
+/// (`/`, `\`, `.svg` next to it), not inside `` ` `` or quotes, not inside a longer word.
+fn rename_loose(lang: Lang, text: &str) -> String {
+    let name = host_app_name(lang);
+    let mut out = String::with_capacity(text.len() + 8);
+    let mut from = 0;
+    let mut search = 0;
+    while let Some(found) = text[search..].find(APP_NAME) {
+        let at = search + found;
+        let end = at + APP_NAME.len();
+        search = end;
+        let before = &text[..at];
+        let after = &text[end..];
+        let quoted = before.matches('`').count() % 2 == 1
+            || before.matches('"').count() % 2 == 1
+            || before.rfind('“').is_some_and(|open| before.rfind('”').is_none_or(|close| close < open));
+        let joined_before = before.chars().last().is_some_and(|c| c.is_alphanumeric() || matches!(c, '/' | '\\' | '_' | '-' | '.'));
+        let mut next = after.chars();
+        let joined_after = match next.next() {
+            Some(c) if c.is_alphanumeric() || matches!(c, '/' | '\\' | '_' | '-') => true,
+            Some('.') => next.next().is_some_and(char::is_alphanumeric),
+            _ => false,
+        };
+        if quoted || joined_before || joined_after {
+            continue;
+        }
+        push_before_name(&mut out, &text[from..at], true);
+        out.push_str(name);
+        from = end;
+    }
+    out.push_str(&text[from..]);
+    out
+}
