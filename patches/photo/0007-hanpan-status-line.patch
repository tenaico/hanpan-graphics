 pub const NO_LAYER_HINT: &str = "Choose a layer first. Click the layer to paint on in the Layers panel.";
 
+/// Hanpan W3: a command that can't run now, as the status line says it (its name, then what to
+/// do when the engine's reason has a hint).
+pub const UNAVAILABLE: &str = "{label}: not available right now.";
+pub const UNAVAILABLE_HINT: &str = "{label}: not available right now. {hint}";
+/// Hanpan W3: any other error the engine or the app words in English, in a language that isn't.
+pub const FAILED: &str = "Couldn't do that.";
+
+/// Hanpan W3: the engine's reasons a user can act on, and what the status line says to do.
+const HINTS: &[(&[&str], &str)] = &[
+    (&["the active layer has no pixels"], "Choose a layer with pixels. Text and shape layers have none."),
+    (&["no document open", "no document", "no active document"], "Make or open a document first."),
+    (&["no active layer", "no layer selected"], "Choose a layer in the Layers panel first."),
+    (&["no selection", "there is no selection"], "Make a selection first."),
+    (&["the active layer is not a type layer", "the document has no type layers"], "Choose a text layer first."),
+    (&["the clipboard is empty"], "The clipboard is empty. Copy something first."),
+    (&["not available on the web (no file system)"], "This isn't available in this window."),
+];
+
+/// The hint, in the interface language, for the engine's `reason`; `None` for a reason with no hint.
+pub fn reason_hint(reason: &str) -> Option<&'static str> {
+    let reason = reason.trim().trim_end_matches('.');
+    HINTS.iter().find(|(reasons, _)| reasons.iter().any(|r| r.eq_ignore_ascii_case(reason))).map(|(_, hint)| tl!(hint))
+}
+
+/// The status line's sentence for command `label` (already in the interface language) that can't
+/// run for the engine's `reason`. A reason with no hint is left out: it is English.
+pub fn unavailable(label: &str, reason: &str) -> String {
+    match reason_hint(reason) {
+        Some(hint) => crate::i18n::fmt(tl!(UNAVAILABLE_HINT), &[("label", label), ("hint", hint)]),
+        None => crate::i18n::fmt(tl!(UNAVAILABLE), &[("label", label)]),
+    }
+}
+
+/// The original text of a status line that is shown reworded goes to the browser console, once.
+fn log_original(status: &str) {
+    thread_local! {
+        static LAST: std::cell::RefCell<String> = const { std::cell::RefCell::new(String::new()) };
+    }
+    LAST.with(|last| {
+        if *last.borrow() != status {
+            log::warn!("status line: {status}");
+            status.clone_into(&mut last.borrow_mut());
+        }
+    });
+}
+
 /// The status line's text as shown: the engine's "no active layer" refusal becomes
 /// [`NO_LAYER_HINT`], whichever path put it there.
 pub fn shown_status(status: &str) -> std::borrow::Cow<'_, str> {
+    shown_status_line(status, false)
+}
+
+/// Hanpan W3: the status line's text as shown, `error` when it is an error. The engine's
+/// developer wording ("command `image.autoTone` is not available right now: the active layer has
+/// no pixels") becomes the command's name and what to do, in the interface language; an error
+/// still in English in another language becomes [`FAILED`]. The original goes to the console.
+pub fn shown_status_line(status: &str, error: bool) -> std::borrow::Cow<'_, str> {
+    use std::borrow::Cow;
     if status.ends_with("is not available right now: no active layer") || status == "no active layer" {
-        std::borrow::Cow::Borrowed(tl!(NO_LAYER_HINT))
-    } else {
-        std::borrow::Cow::Borrowed(status)
+        log_original(status);
+        return Cow::Borrowed(tl!(NO_LAYER_HINT));
+    }
+    if let Some(at) = status.find("command `")
+        && let Some((id, reason)) = status[at + "command `".len()..].split_once("` is not available right now: ")
+    {
+        log_original(status);
+        let label = crate::shortcut_dispatch::label(id);
+        return Cow::Owned(unavailable(crate::i18n::tr_id(crate::i18n::current(), id, &label), reason));
     }
+    let engine = status.starts_with("invalid parameters for `") || status.starts_with("unknown command `");
+    let english = error && crate::i18n::current() != crate::i18n::Lang::EN && status.is_ascii() && !status.trim().is_empty();
+    if engine || english {
+        log_original(status);
+        return Cow::Borrowed(tl!(FAILED));
+    }
+    Cow::Borrowed(status)
 }
 
