diff --git a/crates/ui-egui/src/embedded.rs b/crates/ui-egui/src/embedded.rs
new file mode 100644
index 0000000..6097ab2
--- /dev/null
+++ b/crates/ui-egui/src/embedded.rs
@@ -0,0 +1,53 @@
+//! Hanpan: embedded mode (`?embedded=hanpan` in the page address). The host page owns the files:
+//! it hands PhotoCraft the document and takes the saves, so Open, Open Recent, Close and Close All
+//! are off, and New only makes the first document (from the start screen). Save, Save As and
+//! Export stay as they are. The page API's engine commands are not gated: the host drives them.
+
+/// Does the page query (`location.search`, with or without its `?`) ask for embedded mode?
+pub fn requested(query: &str) -> bool {
+    query.trim_start_matches('?').split('&').any(|kv| kv == "embedded=hanpan")
+}
+
+/// Is command `id` off in embedded mode, with or without a document open?
+pub fn blocks(id: &str, has_document: bool) -> bool {
+    match id {
+        "file.open" | "file.openAs" | "file.close" | "file.closeAll" | "file.closeOthers" | "file.clearRecent" | "file.removeRecent" => true,
+        "file.new" | "file.newFromClipboard" => has_document,
+        id => id.starts_with("file.openRecent."),
+    }
+}
+
+/// Is command `id` gone from the menus in embedded mode (off whatever the documents)?
+pub fn hides(id: &str) -> bool {
+    blocks(id, false)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_flag_is_read_among_other_params() {
+        assert!(requested("?embedded=hanpan"));
+        assert!(requested("?lang=ko&embedded=hanpan"));
+        assert!(requested("embedded=hanpan&webgl"));
+        assert!(!requested(""));
+        assert!(!requested("?embedded=other"));
+        assert!(!requested("?notembedded=hanpan"));
+        assert!(!requested("?embedded=hanpanx"));
+    }
+
+    #[test]
+    fn open_and_close_are_off_and_new_only_makes_the_first_document() {
+        for id in ["file.open", "file.openAs", "file.openRecent.0", "file.close", "file.closeAll"] {
+            assert!(blocks(id, false) && blocks(id, true), "{id}");
+            assert!(hides(id), "{id}");
+        }
+        assert!(!blocks("file.new", false));
+        assert!(blocks("file.new", true));
+        assert!(!hides("file.new"));
+        for id in ["file.save", "file.saveAs", "file.export.exportAs", "file.export.quickExportAsPng"] {
+            assert!(!blocks(id, true), "{id}");
+        }
+    }
+}
