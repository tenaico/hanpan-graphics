+/// 한판 임베디드: 문자 도구 클릭은 "Lorem Ipsum" 없이 빈 커서로 시작하고, 아무것도 쓰지 않고
+/// 끝내면(Esc·커밋) 빈 문자 레이어를 남기지 않는다.
+#[test]
+fn embedded_click_starts_empty_and_an_empty_layer_goes_on_commit() {
+    let mut app = app();
+    app.services.embedded = true;
+    let layers = app.session.active().unwrap().doc.layers.len();
+    assert!(!pointer_down(&mut app, 50.0, 100.0, egui::Modifiers::NONE));
+    pointer_up(&mut app, [50.0, 100.0], [50.0, 100.0]);
+    assert_eq!(layer_text(&app), "", "no placeholder in the embedded build");
+    let ed = app.ui.text_edit.clone().unwrap();
+    assert_eq!((ed.anchor, ed.caret), (0, 0));
+    commit(&mut app);
+    assert_eq!(app.session.active().unwrap().doc.layers.len(), layers, "the empty type layer is removed");
+}
