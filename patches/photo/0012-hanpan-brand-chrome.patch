diff --git a/crates/ui-egui/src/hanpan_brand_tests.rs b/crates/ui-egui/src/hanpan_brand_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9dd8c74bca79d30c46bbb421681a18d0b6f38f89
--- /dev/null
+++ b/crates/ui-egui/src/hanpan_brand_tests.rs
@@ -0,0 +1,151 @@
+//! Hanpan: inside Hanpan (`?embedded=hanpan`) the chrome (menu bar, title bar, panels, dialogs,
+//! start screen, status line) shows no PhotoCraft name or mark, except the About window; the
+//! standalone app is unchanged.
+
+use egui::vec2;
+use egui_kittest::Harness;
+use serde_json::{Map, Value, json};
+
+use crate::PhotocraftApp;
+use crate::state::DialogKind;
+
+fn harness(embedded: bool, language: &str) -> Harness<'static, PhotocraftApp> {
+    let language = language.to_string();
+    let mut h = Harness::builder().with_size(vec2(1440.0, 900.0)).with_max_steps(64).build_eframe(move |cc| {
+        PhotocraftApp::setup_context(&cc.egui_ctx, Default::default());
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services { embedded, ..Default::default() });
+        app.session.edit_prefs(|p| p.interface.language = language.clone());
+        app
+    });
+    h.run_steps(4);
+    h
+}
+
+fn collect(shape: &egui::Shape, out: &mut Vec<String>) {
+    match shape {
+        egui::Shape::Text(t) => out.push(t.galley.text().to_string()),
+        egui::Shape::Vec(shapes) => shapes.iter().for_each(|s| collect(s, out)),
+        _ => {}
+    }
+}
+
+/// Every text painted in the last frame.
+fn texts(h: &Harness<'static, PhotocraftApp>) -> Vec<String> {
+    let mut out = Vec::new();
+    h.output().shapes.iter().for_each(|s| collect(&s.shape, &mut out));
+    out
+}
+
+fn named(texts: &[String]) -> Vec<&String> {
+    texts.iter().filter(|t| t.contains("PhotoCraft")).collect()
+}
+
+fn open_document(h: &mut Harness<'static, PhotocraftApp>) {
+    h.state_mut().run("file.new", json!({"width": 64, "height": 64})).unwrap();
+    h.state_mut().sync_views();
+    h.run_steps(4);
+}
+
+fn open_dialog(h: &mut Harness<'static, PhotocraftApp>, kind: DialogKind, fields: Map<String, Value>) {
+    h.state_mut().ui.open_dialog(kind, fields);
+    h.run_steps(4);
+}
+
+#[test]
+fn embedded_start_screen_and_title_bar_have_no_name_or_mark() {
+    // Latin languages: the test machine may have no CJK face (Korean is checked without drawing).
+    for language in ["fr", "en"] {
+        let mut h = harness(true, language);
+        let shown = texts(&h);
+        assert!(named(&shown).is_empty(), "{language}: start screen and chrome: {:?}", named(&shown));
+        assert!(crate::brand::mark_rect(&h.ctx).is_none(), "{language}: no brand mark");
+        let subtitle = crate::i18n::tr(crate::i18n::Lang::from_code(language).unwrap(), "Create a new document or open an existing file.");
+        assert!(shown.iter().any(|t| t == subtitle), "{language}: the start screen still speaks: {shown:?}");
+        assert_eq!(crate::panels::window_title(h.state()), "", "{language}: no document, no title");
+        open_document(&mut h);
+        let name = h.state().session.active().map(|d| d.doc.name.clone()).unwrap_or_default();
+        let shown = texts(&h);
+        assert!(named(&shown).is_empty(), "{language}: with a document: {:?}", named(&shown));
+        assert!(shown.iter().any(|t| t.starts_with(&name)), "{language}: the title bar names the document {name:?}: {shown:?}");
+        assert_eq!(crate::panels::window_title(h.state()), name);
+        assert!(crate::brand::mark_rect(&h.ctx).is_none(), "{language}: still no brand mark");
+    }
+}
+
+#[test]
+fn embedded_new_document_card_reads_default_size() {
+    for (language, want) in [("en", "Default Size"), ("fr", "Taille par défaut")] {
+        let mut h = harness(true, language);
+        let fields = h.state_mut().new_document_fields();
+        open_dialog(&mut h, DialogKind::NewDocument, fields);
+        let shown = texts(&h);
+        assert!(shown.iter().any(|t| t == want), "{language}: {want:?} in {shown:?}");
+        assert!(named(&shown).is_empty(), "{language}: {:?}", named(&shown));
+    }
+    let ko = crate::i18n::Lang::from_code("ko").unwrap();
+    assert_eq!(crate::i18n::tr(ko, "Default Size"), "기본 크기");
+}
+
+#[test]
+fn embedded_status_line_and_error_dialog_use_hanpans_name() {
+    let mut h = harness(true, "en");
+    open_document(&mut h);
+    let engine = "these smart-object contents are already open in PhotoCraft";
+    h.state_mut().ui.status = engine.into();
+    h.run_steps(2);
+    let shown = texts(&h);
+    assert!(shown.iter().any(|t| t == "these smart-object contents are already open in AI Photo"), "{shown:?}");
+    assert!(named(&shown).is_empty(), "{:?}", named(&shown));
+    assert_eq!(crate::embedded::shown_status(engine), "these smart-object contents are already open in AI Photo");
+    let message = "the file holds no gradients PhotoCraft can use (noise gradients only)";
+    open_dialog(&mut h, DialogKind::Error, json!({"message": message}).as_object().cloned().unwrap_or_default());
+    let shown = texts(&h);
+    assert!(shown.iter().any(|t| t == "the file holds no gradients AI Photo can use (noise gradients only)"), "{shown:?}");
+    assert!(named(&shown).is_empty(), "{:?}", named(&shown));
+}
+
+/// Korean, without drawing (the test machine may have no Hangul face): what the status line shows.
+#[test]
+fn korean_status_line_reads_ai_photo() {
+    let ko = crate::i18n::Lang::from_code("ko").unwrap();
+    crate::i18n::set_host_names(true);
+    crate::i18n::with_language(ko, || {
+        let status = crate::i18n::tr(ko, "Nothing to paste: PhotoCraft can't read the system clipboard here");
+        assert_eq!(crate::embedded::shown_status_line(status, false), "붙여넣을 내용 없음: 여기서는 AI 포토가 시스템 클립보드를 읽을 수 없습니다");
+        let engine = "these smart-object contents are already open in PhotoCraft";
+        assert_eq!(crate::embedded::shown_status_line(engine, false), "these smart-object contents are already open in AI 포토");
+    });
+    crate::i18n::set_host_names(false);
+}
+
+#[test]
+fn embedded_about_window_keeps_the_original_name() {
+    let mut h = harness(true, "en");
+    open_dialog(&mut h, DialogKind::About, Map::new());
+    let shown = texts(&h);
+    for want in ["About PhotoCraft", "PhotoCraft — an open-source, native image editor written in Rust."] {
+        assert!(shown.iter().any(|t| t == want), "{want:?} in {shown:?}");
+    }
+    assert!(shown.iter().any(|t| t.starts_with("Based on PhotoCraft by the ")), "the credit: {shown:?}");
+}
+
+#[test]
+fn not_embedded_keeps_the_brand() {
+    let mut h = harness(false, "en");
+    let shown = texts(&h);
+    assert!(shown.iter().any(|t| t == "PhotoCraft"), "the start screen's title: {shown:?}");
+    assert!(crate::brand::mark_rect(&h.ctx).is_some(), "the brand mark");
+    assert_eq!(crate::panels::window_title(h.state()), "PhotoCraft");
+    let fields = h.state_mut().new_document_fields();
+    open_dialog(&mut h, DialogKind::NewDocument, fields);
+    assert!(texts(&h).iter().any(|t| t == "Default PhotoCraft Size"));
+    h.state_mut().ui.dialogs.clear();
+    open_document(&mut h);
+    let engine = "these smart-object contents are already open in PhotoCraft";
+    h.state_mut().ui.status = engine.into();
+    h.run_steps(2);
+    assert!(texts(&h).iter().any(|t| t == engine));
+    assert_eq!(crate::embedded::shown_status(engine), engine);
+    let name = h.state().session.active().map(|d| d.doc.name.clone()).unwrap_or_default();
