+/// Hanpan: has the interface face arrived (read, not yet taken by the shell)?
+pub fn ui_face_ready() -> bool {
+    UI_ARRIVED.lock().unwrap_or_else(PoisonError::into_inner).is_some()
+}
+
+/// Hanpan: wait until the interface face has arrived, or `until_ms` (page time) has passed.
+pub async fn wait_ui_face(until_ms: f64) {
+    let Some(window) = web_sys::window() else { return };
+    while !ui_face_ready() && UI_FALLBACK.lock().unwrap_or_else(PoisonError::into_inner).is_none() && now_ms() < until_ms {
+        let wait = (until_ms - now_ms()).clamp(1.0, 16.0) as i32;
+        let mut armed = true;
+        let tick = Promise::new(&mut |resolve, _| {
+            armed = window.set_timeout_with_callback_and_timeout_and_arguments_0(&resolve, wait).is_ok();
+        });
+        if !armed {
+            return;
+        }
+        let _ = JsFuture::from(tick).await;
+    }
+}
