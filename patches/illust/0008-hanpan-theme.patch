+    /// Hanpan: the two Hanpan schemes are the AI Word tab's chrome (Hanpan spec 5.1) with the
+    /// illust accent #3E9150; what Word has no counterpart for is the Light or Dark brightness's.
+    #[test]
+    fn hanpan_tokens_match_word() {
+        let t = Tokens::hanpan(false);
+        assert!(!t.dark);
+        assert_eq!(t.app_bar, hex(0xffffff));
+        assert_eq!(t.panel, hex(0xffffff));
+        assert_eq!(t.panel_darker, hex(0xf6f7f9));
+        assert_eq!(t.pasteboard, hex(0xe6e6e6));
+        assert_eq!(t.border, hex(0xe3e6ea));
+        assert_eq!(t.divider, hex(0xefefef));
+        assert_eq!(t.text, hex(0x242424));
+        assert_eq!(t.text_dim, hex(0x606366));
+        assert_eq!((t.accent, t.accent_strong), (hex(0x3e9150), hex(0x3e9150)));
+        assert_eq!((t.input, t.input_border), (hex(0xf6f7f9), hex(0xd9d9d9)));
+        assert_eq!((t.button, t.button_border), (hex(0xffffff), hex(0xe3e6ea)));
+        assert_eq!((t.hover, t.tool_active), (hex(0xf5f5f5), hex(0xe8eaee)));
+        assert_eq!((t.text_disabled, t.text_strong), (hex(0x909499), hex(0x232425)));
+        assert_eq!(t.icon, t.text_dim);
+        assert_eq!(t.tab_strip, hex(0xf6f7f9));
+        assert_eq!(t.row_selected, Color32::from_rgba_unmultiplied(0x3e, 0x91, 0x50, 0x26));
+        // the canvas's own marks, corners and type size are the Light brightness's
+        let base = Tokens::for_brightness(Brightness::Light);
+        assert_eq!((t.smart_guide, t.guide, t.selection, t.anchor_selected), (base.smart_guide, base.guide, base.selection, base.anchor_selected));
+        assert_eq!((t.bleed, t.artboard_mark, t.highlight), (base.bleed, base.artboard_mark, base.highlight));
+        assert_eq!((t.radius, t.font_size), (base.radius, base.font_size));
+
+        let t = Tokens::hanpan(true);
+        assert!(t.dark);
+        assert_eq!(t.app_bar, hex(0x252525));
+        assert_eq!(t.panel, hex(0x1e1e1e));
+        assert_eq!(t.panel_darker, hex(0x2a2a2a));
+        assert_eq!(t.pasteboard, hex(0x2b2b2b));
+        assert_eq!((t.border, t.divider), (hex(0x3a3a3a), hex(0x3a3a3a)));
+        assert_eq!(t.text, hex(0xe4e4e4));
+        assert_eq!(t.text_dim, hex(0xa0a0a0));
+        assert_eq!((t.input, t.input_border), (hex(0x2a2a2a), hex(0x555555)));
+        assert_eq!((t.button, t.button_border), (hex(0x2a2a2a), hex(0x3a3a3a)));
+        assert_eq!((t.hover, t.tool_active), (hex(0x333333), hex(0x444444)));
+        assert_eq!((t.text_disabled, t.text_strong), (hex(0x6b6b6b), hex(0xe4e4e4)));
+        assert_eq!(t.icon, t.text_dim);
+        assert_eq!(t.tab_strip, hex(0x252525));
+        // buttons keep the illust accent behind their white lettering
+        assert_eq!(t.accent_strong, hex(0x3e9150));
+        assert_eq!(t.row_selected, Color32::from_rgba_unmultiplied(0x3e, 0x91, 0x50, 0x26));
+        let base = Tokens::for_brightness(Brightness::Dark);
+        assert_eq!((t.smart_guide, t.guide, t.selection, t.anchor_selected), (base.smart_guide, base.guide, base.selection, base.anchor_selected));
+        assert_eq!((t.radius, t.font_size), (base.radius, base.font_size));
+        // the scheme is the same tokens whatever accent the preferences ask for
+        for accent in Accent::ALL {
+            let light = Tokens::for_scheme(Scheme::Hanpan, Brightness::Light, accent);
+            let dark = Tokens::for_scheme(Scheme::Hanpan, Brightness::Dark, accent);
+            assert_eq!((light.panel, light.accent, light.dark), (hex(0xffffff), hex(0x3e9150), false));
+            assert_eq!((dark.panel, dark.accent_strong, dark.dark), (hex(0x1e1e1e), hex(0x3e9150), true));
+        }
+    }
+
+    /// Hanpan: #3E9150 is 3.9:1 on the dark chrome, under the 4.5:1 its text (links, the active
+    /// tool in a flyout) needs, so the dark scheme draws accent marks and text a lighter shade of
+    /// it; filled buttons keep #3E9150 itself.
+    #[test]
+    fn hanpan_accent_reads_on_both_schemes() {
+        for dark in [false, true] {
+            let t = Tokens::hanpan(dark);
+            for surface in [t.app_bar, t.panel, t.panel_darker, t.input, t.pasteboard, t.hover] {
+                assert!(contrast(t.accent, surface) >= 3.0, "dark={dark}: accent on {surface:?} is {:.2}", contrast(t.accent, surface));
+            }
+            assert!(contrast(t.flyout_active, t.panel) >= 3.0, "dark={dark}: the active tool in a flyout");
+            assert!(contrast(Color32::WHITE, t.accent_strong) >= 3.0, "dark={dark}: button lettering");
+            assert!(contrast(t.text, t.panel) >= 4.5 && contrast(t.text_dim, t.panel) >= 4.5, "dark={dark}: text");
+            let gap = (i32::from(t.button_border.r()) - i32::from(t.panel.r())).abs();
+            assert!(gap >= 24, "dark={dark}: slider rail {:?} on panel {:?}", t.button_border, t.panel);
+        }
+        let t = Tokens::hanpan(true);
+        for surface in [t.app_bar, t.panel, t.panel_darker, t.input] {
+            assert!(contrast(t.accent, surface) >= 4.5, "accent text on {surface:?} is {:.2}", contrast(t.accent, surface));
+        }
+    }
