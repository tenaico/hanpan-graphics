+
+impl Tokens {
+    /// Hanpan: the status bar's fill. In the Hanpan themes it is the AI Word tab's status bar
+    /// (`--docs-statusbar-bg`); every other theme fills it with the chrome, as before.
+    pub fn status_bar_fill(&self) -> Color32 {
+        match self.kind {
+            ThemeKind::HanpanLight => hex(0xf3f4f6),
+            ThemeKind::HanpanDark => hex(0x252525),
+            _ => self.chrome,
+        }
+    }
+
+    /// Hanpan: the line under the menu bar in the Hanpan themes, the AI Word tab's ribbon edge
+    /// (`--border-strong`); `None` keeps the panel's own separator line, as before.
+    pub fn menu_bar_border(&self) -> Option<Color32> {
+        match self.kind {
+            ThemeKind::HanpanLight => Some(hex(0xd9d9d9)),
+            ThemeKind::HanpanDark => Some(hex(0x555555)),
+            _ => None,
+        }
+    }
+}
