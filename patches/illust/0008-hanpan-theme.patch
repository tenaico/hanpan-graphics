+    /// Hanpan: no menu, key, command, preference or `ui.set` changes the theme inside Hanpan.
+    #[test]
+    fn hanpan_embedded_brightness_paths_leave_the_theme_alone() {
+        let ctx = egui::Context::default();
+        let mut app = app(true);
+        start_theme(&mut app, &ctx, HanpanMode::Dark);
+        let saved = app.session.prefs.ui_brightness.clone();
+        assert!(blocks("window.brightness", false) && blocks("window.brightness", true) && hides("window.brightness"));
+        assert!(!crate::menus::enabled(&app, "window.brightness"));
+        assert_eq!(crate::menus::shown_state(&app, "window.brightness", &json!({"brightness": "light"})), None);
