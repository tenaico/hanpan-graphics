diff --git a/crates/ui-egui/src/hanpan_brand_tests.rs b/crates/ui-egui/src/hanpan_brand_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0156184e4a6a2500a236aaa0c7784d4992bc30e2
--- /dev/null
+++ b/crates/ui-egui/src/hanpan_brand_tests.rs
@@ -0,0 +1,261 @@
+//! Hanpan: inside Hanpan (`?embedded=hanpan`) the chrome (app bar, menus, panels, dialogs, Home
+//! screen, status line) shows no VectorCraft name or mark, except the About window; the Home
+//! screen speaks in Hanpan's voice. The standalone app is unchanged.
+
+use std::sync::{Arc, Mutex};
+
+use serde_json::json;
+
+use crate::VectorcraftApp;
+use crate::menus::Entry;
+
+fn app(embedded: bool, language: &str) -> VectorcraftApp {
+    let mut app = VectorcraftApp::new(vectorcraft_engine::Session::new(), crate::Services { embedded, ..Default::default() });
+    app.session.prefs.interface_language = language.to_string();
+    // The app bar draws the in-app mark (as the web build and the custom title bar do).
+    app.custom_titlebar = true;
+    app
+}
+
+fn collect(shape: &egui::Shape, out: &mut Vec<String>) {
+    match shape {
+        egui::Shape::Text(t) => out.push(t.galley.text().to_string()),
+        egui::Shape::Vec(shapes) => shapes.iter().for_each(|s| collect(s, out)),
+        _ => {}
+    }
+}
+
+/// One headless frame of the whole window: every text it painted, and whether it painted the
+/// brand mark.
+fn frame(app: &mut VectorcraftApp, ctx: &egui::Context) -> (Vec<String>, bool) {
+    let screen_rect = Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1600.0, 900.0)));
+    let mut out = ctx.run_ui(egui::RawInput { screen_rect, ..Default::default() }, |ui| {
+        app.logic(ui.ctx());
+        app.ui(ui);
+    });
+    out.textures_delta.clear();
+    let mark = crate::brand::texture_id(ctx);
+    let mut texts = Vec::new();
+    out.shapes.iter().for_each(|c| collect(&c.shape, &mut texts));
+    let marked = out.shapes.iter().any(|c| matches!(&c.shape, egui::Shape::Mesh(m) if m.texture_id == mark));
+    (texts, marked)
+}
+
+/// A few frames (fonts and layout settle), the last one's texts and mark.
+fn frames(app: &mut VectorcraftApp, ctx: &egui::Context) -> (Vec<String>, bool) {
+    for _ in 0..3 {
+        frame(app, ctx);
+    }
+    frame(app, ctx)
+}
+
+fn context() -> egui::Context {
+    let ctx = egui::Context::default();
+    crate::theme::install_fonts(&ctx);
+    ctx
+}
+
+fn named(texts: &[String]) -> Vec<&String> {
+    texts.iter().filter(|t| t.contains(crate::i18n::APP_NAME)).collect()
+}
+
+/// The Help menu's rows as the menus show them now: (English source, label).
+fn help_rows(app: &VectorcraftApp) -> Vec<(&'static str, String)> {
+    let tree = crate::menus::menu_tree();
+    let help = &tree.iter().find(|(title, _)| *title == "Help").expect("a Help menu").1;
+    help.iter()
+        .filter_map(|it| match crate::menus::entry(app, it)? {
+            Entry::Item(row) => Some((row.source, row.label.to_string())),
+            _ => None,
+        })
+        .collect()
+}
+
+#[test]
+fn embedded_app_bar_and_window_title_have_no_name_or_mark() {
+    for language in ["fr", "en"] {
+        let ctx = context();
+        let mut app = app(true, language);
+        let (texts, marked) = frames(&mut app, &ctx);
+        assert!(!marked, "{language}: no brand mark in the app bar");
+        assert!(named(&texts).is_empty(), "{language}: {:?}", named(&texts));
+        assert_eq!(crate::chrome::window_title(&app), "", "{language}: no document, no title");
+        app.run("file.new", json!({"width": 100, "height": 100, "name": "foo.svg"})).unwrap();
+        let (texts, marked) = frames(&mut app, &ctx);
+        assert!(!marked && named(&texts).is_empty(), "{language}: with a document: {:?}", named(&texts));
+        assert_eq!(crate::chrome::window_title(&app), "foo.svg");
+    }
+    // The macOS-style centred title is not drawn either.
+    let ctx = context();
+    let mut app = app(true, "en");
+    app.services.native_menu = Some(crate::native_menu::NativeMenu::new(Box::new(NoMenus)));
+    let mut out = ctx.run_ui(egui::RawInput::default(), |ui| crate::chrome::app_bar(&mut app, ui));
+    out.textures_delta.clear();
+    let mut texts = Vec::new();
+    out.shapes.iter().for_each(|c| collect(&c.shape, &mut texts));
+    assert!(named(&texts).is_empty(), "{:?}", named(&texts));
+}
+
+struct NoMenus;
+impl crate::native_menu::Backend for NoMenus {
+    fn sync(&mut self, _: &crate::native_menu::MenuBar) {}
+    fn drain(&mut self) -> Vec<crate::native_menu::Event> {
+        Vec::new()
+    }
+}
+
+#[test]
+fn embedded_help_menu_has_no_vectorcraft_help() {
+    let app = app(true, "en");
+    let rows = help_rows(&app);
+    assert!(!rows.iter().any(|(source, _)| *source == "VectorCraft Help…"), "{rows:?}");
+    assert!(rows.iter().any(|(source, _)| *source == "Search Commands…"), "the rest stays: {rows:?}");
+    // The About item keeps the name (the About window's own title).
+    assert!(rows.iter().any(|(_, label)| label == "About VectorCraft"), "{rows:?}");
+    let listed = crate::menus::menu_entries(&app);
+    assert!(!listed.iter().any(|e| e.label == "VectorCraft Help…"), "ui.menu.list lists it");
+}
+
+#[test]
+fn embedded_home_speaks_in_hanpans_voice() {
+    for language in ["en", "fr"] {
+        let ctx = context();
+        let mut app = app(true, language);
+        let (texts, _) = frames(&mut app, &ctx);
+        let lang = crate::i18n::Lang::from_code(language).unwrap();
+        let title = crate::i18n::tr(lang, "Create a new drawing or open a file.");
+        assert!(texts.iter().any(|t| t == title), "{language}: {title:?} in {texts:?}");
+        let tagline = crate::i18n::tr(lang, "Vector illustration — fast, open, scriptable.");
+        assert!(!texts.iter().any(|t| t == tagline), "{language}: no tagline: {texts:?}");
+        assert!(named(&texts).is_empty(), "{language}: {:?}", named(&texts));
+        // New file and the presets stay.
+        assert!(texts.iter().any(|t| t == crate::i18n::tr(lang, "New file")), "{language}: {texts:?}");
+    }
+    let ko = crate::i18n::Lang::from_code("ko").unwrap();
+    assert_eq!(crate::i18n::tr(ko, "Create a new drawing or open a file."), "새 그림을 만들거나 파일을 여세요.");
+}
+
+#[test]
+fn embedded_about_keeps_the_name_and_opens_no_link() {
+    let opened = Arc::new(Mutex::new(Vec::<String>::new()));
+    let o = opened.clone();
+    let ctx = context();
+    let mut app = app(true, "en");
+    app.services.open_url = Some(Box::new(move |u: &str| o.lock().unwrap().push(u.to_string())));
+    app.ui.about = true;
+    let (texts, marked) = frames(&mut app, &ctx);
+    for want in ["About VectorCraft", "VectorCraft"] {
+        assert!(texts.iter().any(|t| t == want), "{want:?} in {texts:?}");
+    }
+    assert!(texts.iter().any(|t| t.starts_with("Based on VectorCraft by the ")), "the credit: {texts:?}");
+    assert!(texts.iter().any(|t| t.ends_with("Icons: Lucide (ISC) + VectorCraft.")), "the licences: {texts:?}");
+    assert!(marked, "the About window keeps the mark");
+    assert!(!texts.iter().any(|t| t == "Source code on GitHub"), "no link out of the app: {texts:?}");
+    app.open_link("help.github");
+    assert!(opened.lock().unwrap().is_empty(), "GitHub does not open: {:?}", opened.lock().unwrap());
+}
+
+#[test]
+fn embedded_status_line_uses_hanpans_name() {
+    let ctx = context();
+    let mut app = app(true, "en");
+    app.run("file.new", json!({"width": 100, "height": 100})).unwrap();
+    app.status("Lock Workspace is not available in VectorCraft");
+    let (texts, _) = frames(&mut app, &ctx);
+    assert!(texts.iter().any(|t| t == "Lock Workspace is not available in AI Illustration"), "{texts:?}");
+    assert!(named(&texts).is_empty(), "{:?}", named(&texts));
+    app.status("not a VectorCraft file: format is `svg`");
+    let (texts, _) = frames(&mut app, &ctx);
+    assert!(texts.iter().any(|t| t == "not an AI Illustration file: format is `svg`"), "{texts:?}");
