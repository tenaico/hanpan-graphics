+        assert_eq!(HanpanMode::from_query("?embedded=hanpan"), HanpanMode::Light);
+        assert_eq!(HanpanMode::from_query("?embedded=hanpan&theme=blue"), HanpanMode::Light);
+        assert_eq!(HanpanMode::from_query("?embedded=hanpan&xtheme=dark"), HanpanMode::Light);
+        assert_eq!(HanpanMode::Light.kind(), ThemeKind::HanpanLight);
+        assert_eq!(HanpanMode::Dark.kind(), ThemeKind::HanpanDark);
