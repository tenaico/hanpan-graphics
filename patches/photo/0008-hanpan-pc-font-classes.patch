+            ("Lucida Calligraphy", Some(Script)),
+            ("Segoe Print", Some(Handwritten)),
+            ("Ink Free", Some(Handwritten)),
+            ("Comic Sans MS", Some(Handwritten)),
+            ("Nanum Pen Script", Some(Handwritten)),
