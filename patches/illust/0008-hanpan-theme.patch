+/// Hanpan: the host's theme, light or dark (`hanpan.theme {mode}` and the page address's
+/// `theme=light|dark`). Inside Hanpan VectorCraft draws only [`Scheme::Hanpan`] at this mode; its
+/// own Brightness, Color Scheme and Accent Color preferences are kept but not shown.
+///
+/// [`Scheme::Hanpan`]: crate::theme::Scheme::Hanpan
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum HanpanMode {
+    #[default]
+    Light,
+    Dark,
+}
+
+impl HanpanMode {
+    pub fn from_name(name: &str) -> Option<Self> {
+        match name {
+            "light" => Some(Self::Light),
+            "dark" => Some(Self::Dark),
+            _ => None,
+        }
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Light => "light",
+            Self::Dark => "dark",
+        }
+    }
+
+    /// The brightness [`crate::theme::Scheme::Hanpan`] is drawn at.
+    pub fn brightness(self) -> crate::theme::Brightness {
+        match self {
+            Self::Light => crate::theme::Brightness::Light,
+            Self::Dark => crate::theme::Brightness::Dark,
+        }
+    }
+
+    /// The page query's `theme=light|dark` (`location.search`, with or without its `?`); light
+    /// when it is missing or another value.
+    pub fn from_query(query: &str) -> Self {
+        query.trim_start_matches('?').split('&').find_map(|kv| kv.strip_prefix("theme=")).and_then(Self::from_name).unwrap_or_default()
+    }
+}
+
+/// The interface font `hanpan.status` reports (Task 4 makes it the PC's Korean font).
+pub const UI_FONT: &str = "NanumGothic";
+
+/// The error `hanpan.theme` and `hanpan.status` give outside Hanpan.
+pub const NOT_EMBEDDED: &str = "only available in embedded mode (?embedded=hanpan)";
+
+/// The first frame's theme: `mode` from the page address, pushed into `ctx` before anything is
+/// drawn and without touching the saved preferences.
+pub fn start_theme(app: &mut crate::VectorcraftApp, ctx: &egui::Context, mode: HanpanMode) {
+    app.ui.hanpan_mode = mode;
+    crate::prefs_dialog::reapply(app, ctx);
+}
+
+/// `hanpan.theme {mode: "light" | "dark"}`: switch at once (the reply's frame already draws it);
+/// the documents and the saved preferences are left alone. Reply `{mode}`.
+pub fn set_theme(app: &mut crate::VectorcraftApp, ctx: &egui::Context, params: &serde_json::Value) -> Result<serde_json::Value, String> {
+    if !app.services.embedded {
+        return Err(format!("hanpan.theme is {NOT_EMBEDDED}"));
+    }
+    let mode = match params.get("mode") {
+        Some(serde_json::Value::String(name)) => HanpanMode::from_name(name).ok_or_else(|| format!("unknown mode `{name}` (light, dark)"))?,
+        Some(_) => return Err("`mode` must be \"light\" or \"dark\"".into()),
+        None => return Err("missing `mode` (light, dark)".into()),
+    };
+    app.ui.hanpan_mode = mode;
+    crate::prefs_dialog::reapply(app, ctx);
+    ctx.request_repaint();
+    Ok(serde_json::json!({"mode": mode.name()}))
+}
+
+/// `hanpan.status {}`: `{mode, uiFont}`.
+pub fn status(app: &crate::VectorcraftApp) -> serde_json::Value {
+    serde_json::json!({"mode": app.ui.hanpan_mode.name(), "uiFont": UI_FONT})
+}
