+/// Hanpan: inside Hanpan the theme is the host's. Preferences › Interface shows no Appearance
+/// Mode or theme rows, and the title bar has no appearance button; standalone keeps both.
+#[test]
+fn hanpan_embedded_hides_the_theme_choices() {
+    use egui_kittest::{Harness, kittest::Queryable};
+    let render = |embedded: bool| {
+        let (mut app, _) = app_with_store();
+        app.run("prefs.set", json!({"values": {"interface.language": "en", "interface.appearanceMode": "auto"}})).unwrap();
+        app.services.embedded = embedded;
+        open_preferences(&mut app, "interface");
+        let mut h = Harness::builder().with_size(vec2(1400.0, 800.0)).build_eframe(move |cc| {
+            PhotocraftApp::setup_context(&cc.egui_ctx, Default::default());
+            if embedded {
+                crate::embedded::start_theme(&mut app, &cc.egui_ctx, crate::embedded::HanpanMode::Dark);
